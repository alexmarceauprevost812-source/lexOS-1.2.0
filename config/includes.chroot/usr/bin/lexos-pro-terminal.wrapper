#!/bin/bash
# =============================================================================
#  lexos-pro-terminal.wrapper — pont x-terminal-emulator → LexOS Pro Terminal
# =============================================================================
#  ALEX : « je voudrais juste que le terminal principal du système soit le
#  terminal LexOS Pro ».
#
#  ═══ CE PONT NE DÉTOURNE PLUS RIEN ═══
#  Il a longtemps renvoyé vers le Terminal classique tout ce qui demandait
#  d'EXÉCUTER une commande (« x-terminal-emulator -e … »), parce que
#  terminal-pro.py ne lisait aucun argument : brancher l'alternative Debian
#  dessus aurait ouvert une fenêtre VIDE, en silence, chaque fois qu'un
#  programme du système demande un terminal pour lancer quelque chose.
#
#  LexOS Pro Terminal a maintenant un vrai pseudo-terminal ET lit ses
#  arguments — « -e », « -x », « --command », « --working-directory » et
#  « --hold » (voir lire_arguments() dans /usr/lib/lexos/terminal-pro.py,
#  qui distingue le « -e "ls -la" » de xfce4-terminal du « -e ls -la » de
#  la convention Debian). Le détournement n'a donc plus lieu d'être.
#
#  ═══ POURQUOI CE FICHIER RESTE, PLUTÔT QUE DE BRANCHER LE LANCEUR ═══
#  update-alternatives pointe sur CE chemin. Le supprimer pour brancher
#  /usr/bin/lexos-pro-terminal à sa place obligerait à défaire puis refaire
#  l'alternative sur toutes les machines déjà installées — et une alternative
#  cassée, c'est plus aucun terminal pour personne. Un exec d'une ligne coûte
#  moins cher que ce risque.
#
#  ═══ RETOUR EN ARRIÈRE, À GARDER SOUS LA MAIN ═══
#      sudo update-alternatives --set x-terminal-emulator \
#           /usr/bin/xfce4-terminal.wrapper
#      sed -i 's|^TerminalEmulator=.*|TerminalEmulator=xfce4-terminal|' \
#           ~/.config/xfce4/helpers.rc
# =============================================================================
exec /usr/bin/lexos-pro-terminal "$@"
