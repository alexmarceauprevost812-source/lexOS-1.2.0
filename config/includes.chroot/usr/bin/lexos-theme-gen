#!/usr/bin/env bash
# =============================================================================
#  lexos-theme-gen — génère le thème LexOS (GTK + terminal) pour un accent
# =============================================================================
#  Usage :
#     lexos-theme-gen                      # accent et mode courants
#     lexos-theme-gen orange               # change l'accent
#     lexos-theme-gen bleu --target /etc/skel
#     lexos-theme-gen --mode clair         # thème de jour (fond blanchâtre)
#     lexos-theme-gen --mode sombre        # LexOS Noir — défaut
# =============================================================================
set -euo pipefail

ACCENT_NAME=""
MODE=""
TERM_MODE=""
TARGET="$HOME"

# --- Arguments ---------------------------------------------------------------
while [[ $# -gt 0 ]]; do
	case "$1" in
		--target)
			TARGET="${2:-$HOME}"
			shift 2
			;;
		--terminal)
			TERM_MODE="${2:-}"
			shift 2
			;;
		--mode)
			MODE="${2:-}"
			shift 2
			;;
		--list)
			# Doit rester d'accord avec la palette plus bas : orange-rouge y
			# figurait sans jamais apparaître ici, et cette liste sert aussi
			# de source à la complétion Tab.
			printf 'orange orange-rouge bleu rouge vert gris violet neon\n'
			exit 0
			;;
		-*)
			printf 'Option inconnue : %s\n' "$1" >&2
			exit 1
			;;
		*)
			ACCENT_NAME="$1"
			shift
			;;
	esac
done

CONF_DIR="$TARGET/.config/lexos"
[[ -z "$ACCENT_NAME" && -r "$CONF_DIR/accent" ]] && ACCENT_NAME="$(cat "$CONF_DIR/accent")"
[[ -z "$ACCENT_NAME" ]] && ACCENT_NAME="orange"

# --- Mode : sombre (LexOS Noir, défaut) ou clair (thème de jour) -----------
[[ -z "$MODE" && -r "$CONF_DIR/mode" ]] && MODE="$(cat "$CONF_DIR/mode")"
[[ -z "$MODE" ]] && MODE="sombre"
case "${MODE,,}" in
	clair|jour|light|day)     MODE="clair" ;;
	sombre|nuit|dark|night|*) MODE="sombre" ;;
esac

# --- Mode du TERMINAL : suivre le bureau, ou épinglé jour / nuit -------------
#  DEMANDE D'ALEX, DEUXIÈME VERSION : « écriture blanc pour écriture de
#  utilisateur, vert pour lexos ». (La première disait « orange » ; c'est
#  celle-ci qui vaut.) C'est le rôle de TERM_TEXTE plus bas — et c'est PS1
#  qui le porte : l'invite se termine par cette couleur SANS la refermer,
#  PS0 la remet à zéro quand on appuie sur Entrée. Résultat : la frappe est
#  blanche, la SORTIE de la commande ne l'est pas. Sans PS0, tout l'écran
#  deviendrait blanc.
#
#  « auto » n'est PAS résolu ici : c'est lexos-terminal qui connaît l'heure
#  et l'horaire choisi, et qui rappelle ce script avec jour ou nuit. Si le
#  fichier contient quand même « auto » (génération lancée à la main), on
#  retombe sur le bureau plutôt que d'inventer une heure.
[[ -z "$TERM_MODE" && -r "$CONF_DIR/terminal-mode" ]] && TERM_MODE="$(cat "$CONF_DIR/terminal-mode")"
[[ -z "$TERM_MODE" ]] && TERM_MODE="suivre"
case "${TERM_MODE,,}" in
	jour|clair|light|day)     TERM_MODE="jour" ;;
	nuit|sombre|dark|night)   TERM_MODE="nuit" ;;
	suivre|auto|*)            TERM_MODE="suivre" ;;
esac
if [[ "$TERM_MODE" == "suivre" ]]; then
	TERM_EFFECTIF=$([[ "$MODE" == "clair" ]] && echo jour || echo nuit)
else
	TERM_EFFECTIF="$TERM_MODE"
fi

# --- Palette des accents -----------------------------------------------------
case "${ACCENT_NAME,,}" in
	# « classique » : le nom que les paramètres affichent pour cette couleur
	# (app.js — ["orange", "Classique", …]). Sans cet alias, un utilisateur
	# qui lisait « Classique » à l'écran et tapait « lexos accent classique »
	# se faisait répondre « Accent inconnu » : l'interface et le terminal ne
	# parlaient pas la même langue.
	orange|ambre|classique) ACCENT="#E8590C"; ACCENT_HI="#FF7A33"; ACCENT_LO="#A84007" ;;
	# « Orange et rouge » — l'accent chaud, celui qui va du terracotta au
	# rouge brique. C'est le second des deux styles proposés en tête des
	# paramètres ; l'orange plus vif ci-dessus reste le style « classique ».
	# Le ton principal est l'argile #D97757, ses appuis sont l'orange franc
	# et le rouge brique déjà retenu plus bas pour son contraste.
	orange-rouge|orangerouge|claude|chaud)
	                       ACCENT="#D97757"; ACCENT_HI="#E8834F"; ACCENT_LO="#C4211E" ;;
	# Bleu 5 de la palette Adwaita — le bleu profond des bureaux Linux.
	bleu|blue)             ACCENT="#1A5FB4"; ACCENT_HI="#3584E4"; ACCENT_LO="#10375F" ;;
	# Rouge brique, celui de la référence fournie : plus profond et moins
	# rosé que le #E5484D d'avant, et son texte blanc passe de 3,91:1 à
	# 5,86:1 — au-dessus du seuil AA, ce que l'ancien ne tenait pas.
	rouge|red)             ACCENT="#C4211E"; ACCENT_HI="#D8352E"; ACCENT_LO="#8A1512" ;;
	vert|green|vert-dark)  ACCENT="#1F8F4E"; ACCENT_HI="#2DBF6B"; ACCENT_LO="#125C32" ;;
	gris|grey|gray|grid)   ACCENT="#8A8A8A"; ACCENT_HI="#B4B4B4"; ACCENT_LO="#5A5A5A" ;;
	violet|purple)         ACCENT="#8B5CF6"; ACCENT_HI="#A78BFA"; ACCENT_LO="#6234D1" ;;
	neon|vert-neon|vertneon) ACCENT="#39FF14"; ACCENT_HI="#7BFF5C"; ACCENT_LO="#1FA30A" ;;
	*)
		printf 'Accent inconnu : %s\n' "$ACCENT_NAME" >&2
		printf 'Disponibles : orange (= classique) orange-rouge bleu rouge vert gris violet neon\n' >&2
		exit 1
		;;
esac
ACCENT_NAME="${ACCENT_NAME,,}"

# --- Palette du bureau : LexOS Noir (sombre, défaut) ou thème de jour ------
#  Les boutons sont peints à l'accent dans les deux modes. Plutôt qu'un seuil
#  approximatif, on calcule le VRAI contraste WCAG du noir et du blanc sur
#  l'accent, et on garde celui qui contraste le mieux.
#  L'ancienne formule (299r+587g+114b > 150) choisissait le blanc sur le bleu
#  et sur l'orange, où le noir contraste pourtant nettement mieux : mesuré,
#  ça donnait 3,3 au lieu de 5,4 — sous le seuil lisible de 4,5.
#  ON EN A FAIT UNE FONCTION, ET PAS PAR GOÛT DU RANGEMENT. Le calcul ne
#  servait qu'à l'accent ; deux boutons y échappaient — « action conseillée »
#  et « suppression » — qui posent un FOND sans jamais poser de couleur de
#  texte. Ils héritaient donc de celle de l'accent : sur un accent bleu, du
#  BLANC se retrouvait sur le rouge #E5484D du bouton de suppression, à 3,9:1.
#  Trouvé par le banc des boutons, pas à l'œil : la règle a l'air correcte
#  isolément, c'est la cascade qui la trahit.
texte_lisible() {   # <#rrggbb> → #000000 ou #FFFFFF, celui qui contraste le mieux
	local h="${1#\#}" rr gg bb sortie
	rr=$((16#${h:0:2})); gg=$((16#${h:2:2})); bb=$((16#${h:4:2}))
	sortie="$(awk -v r="$rr" -v g="$gg" -v b="$bb" '
		function lin(v){ v/=255; return (v<=0.03928) ? v/12.92 : ((v+0.055)/1.055)^2.4 }
		BEGIN{
			L  = 0.2126*lin(r) + 0.7152*lin(g) + 0.0722*lin(b)
			cw = 1.05 / (L + 0.05)      # contraste du blanc
			cb = (L + 0.05) / 0.05      # contraste du noir
			print (cb >= cw) ? "#000000" : "#FFFFFF"
		}')"
	printf '%s' "${sortie:-#FFFFFF}"   # filet si awk venait à manquer
}

BTN_FG="$(texte_lisible "$ACCENT")"

#  ═══ LE GRIS DE LA GRILLE D'APPLICATIONS ═══
#  Voir la règle « iconview:selected » plus bas : la tuile sélectionnée de la
#  Liste des applications ne prend PAS l'accent, à la demande d'Alex. Un gris
#  pâle, identique dans les deux modes — il se détache aussi bien du noir que
#  du crème — et son texte calculé par la même fonction que tous les autres
#  boutons, pour n'avoir qu'une seule idée du contraste dans ce fichier.
SEL_GRILLE="#C4C8D0"
SEL_GRILLE_TXT="$(texte_lisible "$SEL_GRILLE")"

#  r, g, b restent nécessaires ailleurs : bloc_panneau() traduit les rgba() du
#  squelette avec « ${r}, ${g}, ${b} ». Les avoir fondus dans texte_lisible()
#  les a fait disparaître d'ici — et le générateur s'est arrêté sur « r :
#  variable sans valeur ». Attrapé par le banc des boutons, qui n'a plus rien
#  eu à mesurer : une feuille absente est aussi parlante qu'une feuille fausse,
#  à condition que quelqu'un la réclame.
r=$((16#${ACCENT:1:2})); g=$((16#${ACCENT:3:2})); b=$((16#${ACCENT:5:2}))

#  Le rouge du bouton de suppression ne dépend pas de l'accent : il dit
#  « attention », et cette couleur-là ne se choisit pas. Son texte, si.
DANGER="#E5484D"
DANGER_FG="$(texte_lisible "$DANGER")"
# =============================================================================
#  LES DEUX TERMINAUX : CELUI DE NUIT ET CELUI DE JOUR
# =============================================================================
#  AVANT, UNE SEULE LIGNE DÉCIDAIT DE TOUT : « TERM_BG="#000000" », en dur.
#  Le bureau savait passer en clair depuis longtemps ; le terminal, non. On
#  livrait donc un thème de jour avec un trou noir au milieu.
#
#  Chaque palette définit les MÊMES rôles, pour que le reste du fichier
#  (terminalrc, GTK, invite) n'ait pas à savoir lequel des deux est actif :
#     TERM_BG        le fond
#     TERM_FG        le vert de la MACHINE — ce qu'elle répond
#     TERM_FG_HI     le même en gras
#     TERM_SAISIE    l'orange de l'ACCENT dans le terminal (curseur,
#                    sélection, onglet actif) — PAS l'invite
#     TERM_TEXTE     l'encre de CE QUE VOUS TAPEZ (blanche de nuit)
#     TERM_ERREUR    le rouge de l'échec
#     TERM_DIM       le gris des détails (branche git)
#     TERM_CURSEUR   le curseur
#
#  LA RÈGLE DE COULEUR NE CHANGE PAS d'un mode à l'autre — vert = la machine,
#  blanc = vous, rouge = l'échec. Le jour n'est pas une autre identité, c'est
#  la même règle retranscrite pour un fond clair : le « blanc » de nuit y
#  devient l'encre foncée, sans quoi la frappe disparaîtrait sur le crème.
#
#  ALEX, PHOTO DU TERMINAL : « écriture blanc pour écriture de utilisateur,
#  vert pour lexos ». L'invite était orange sur son chemin et sur son
#  chevron, et la frappe héritait de cet orange. Désormais TOUT ce que la
#  machine écrit est vert (le nom, la machine, le chemin, le chevron) et
#  TOUT ce qu'on tape est blanc. L'orange n'a pas disparu du terminal pour
#  autant : il reste le curseur, la sélection et l'onglet actif — c'est
#  TERM_SAISIE, qui ne touche plus à l'invite.
#
#  LES CONTRASTES SONT MESURÉS, PAS ESTIMÉS (WCAG, sur leur propre fond) :
#     nuit  : vert 7,30 · orange 5,87 · rouge 5,37
#     jour  : vert 6,06 · orange 5,67 · rouge 6,00
#  Tous au-dessus du seuil AA de 4,5, et les seize couleurs ANSI de jour
#  aussi — vérifié une par une. Poser les couleurs de NUIT telles quelles
#  sur le crème donnerait 2,64 pour le vert et 3,29 pour l'orange : illisible.
#  C'est pour ça qu'il y a deux palettes et pas une avec un fond échangé.
#
#  PAS DE « TERM_SAISIE_HI » NI DE « TERM_ERREUR_HI » : les variantes en gras
#  existent déjà, écrites en clair dans la moitié « brillante » de
#  TERM_PALETTE. Les définir une seconde fois donnait deux variables que
#  personne ne lisait — shellcheck les a nommées, et deux écritures de la
#  même couleur finissent toujours par diverger.
if [[ "$TERM_EFFECTIF" == "jour" ]]; then
	#  Terminal de JOUR — le même crème que le bureau clair, encre foncée.
	#  L'accent de l'utilisateur est repris par son ton SOMBRE (ACCENT_LO) :
	#  l'orange vif #E8590C ne donne que 3,29:1 sur ce fond, son ton sombre
	#  #A84007 en donne 5,67. Un accent déjà foncé est repris tel quel.
	TERM_BG="#F7F5F0"
	TERM_FG="#0B6B3A"
	TERM_FG_HI="#084F2B"
	TERM_SAISIE="$ACCENT_LO"
	#  L'encre de la frappe. Le « blanc » de nuit n'a pas de sens sur du
	#  crème : on prend le noir de la palette claire (#1B1A17, sa couleur
	#  0), qui donne 15,9:1 sur ce fond — mesuré, pas estimé.
	TERM_TEXTE="#1B1A17"
	TERM_ERREUR="#B3261E"
	TERM_DIM="#6B675E"
	#  Les deux rôles de l'invite (ALEX : « le nom de l'utilisateur en rouge
	#  clair, à côté LEXOS en vert foncé »), convertis pour le crème comme
	#  les autres : un rouge CLAIR sur du crème serait illisible. Mesurés sur
	#  #F7F5F0 : #9A1B14 donne 7,59:1, #0F5A24 donne 7,68:1.
	TERM_UTILISATEUR="#9A1B14"
	TERM_LOGO="#0F5A24"
	TERM_CURSEUR="$ACCENT_LO"
	TERM_SEL_BG="$ACCENT_LO"
	TERM_SEL_FG="#FFFFFF"
	TERM_TRANSPARENCE="1.00"
	#  Seize couleurs, version claire : les « brillantes » sont ici plus
	#  FONCÉES que les normales, puisque c'est le fond qui est clair.
	TERM_PALETTE="#1B1A17;#B3261E;#0B6B3A;#A15C00;#1A5FB4;#6234D1;#0F6E68;#57534A"
	TERM_PALETTE="${TERM_PALETTE};#3B3830;#8A1512;#084F2B;#7A4300;#123F7E;#4A25A3;#0A524D;#2B2924"
else
	#  Terminal de NUIT — LexOS Noir. PHOTO D'ALEX : « un vert plus visible ».
	#  #00AF5F passait déjà le seuil WCAG (7,3:1 sur noir, mesuré) mais restait
	#  un vert sourd — pas un problème de contraste, un problème de vivacité.
	#  #00D700 (10,7:1 sur noir) reste un vert FONCÉ, PAS le vert néon
	#  réservé à l'accent « neon » (#39FF14, choisi avec « lexos accent
	#  neon ») : on monte d'un cran sans aller jusque-là.
	#
	#  #00D700 EST EXACTEMENT le 38;5;40 de la palette 256 termcap — comme
	#  #00AF5F l'était pour 38;5;35 : la coïncidence qui empêche l'invite
	#  (PS_MACHINE_256, plus bas) et le terminal de diverger tient encore.
	#  #00FF5F (38;5;47), pour le gras, garde le même glacis vert-menthe que
	#  l'ancien FG_HI, juste plus haut sur l'échelle.
	TERM_BG="#000000"
	TERM_FG="#00D700"
	TERM_FG_HI="#00FF5F"
	TERM_SAISIE="$ACCENT"
	#  Le blanc demandé, franc : 21:1 sur le noir. C'est aussi la couleur
	#  15 de TERM_PALETTE (le « blanc brillant ») — une seule valeur pour
	#  la frappe et pour le blanc du terminal, pas deux libres de diverger.
	TERM_TEXTE="#FFFFFF"
	TERM_ERREUR="#E5484D"
	TERM_DIM="#8A8A90"
	#  L'INVITE, TROIS RÔLES — ALEX : « le nom de l'utilisateur en rouge
	#  clair, à côté LEXOS en vert foncé, ce qu'il tape en blanc franc ».
	#  Le rouge clair : #FF7B7B, 8,37:1 sur le noir — ce n'est pas le rouge
	#  d'erreur (#E5484D), qui reste au chevron des commandes en échec.
	#  Le vert FONCÉ se lit mal sur du noir en dessous de #0F7A2E environ
	#  (3,84:1) : #159A3D, regardé sur du noir, donne 5,72:1 et reste
	#  nettement plus sombre que le vert machine #00D700 — le mot LEXOS se
	#  distingue du chemin sans se confondre avec lui.
	TERM_UTILISATEUR="#FF7B7B"
	TERM_LOGO="#159A3D"
	TERM_CURSEUR="$ACCENT"
	TERM_SEL_BG="$ACCENT"
	TERM_SEL_FG="$BTN_FG"
	TERM_TRANSPARENCE="0.94"
	TERM_PALETTE="#0B0B0C;#E5484D;${TERM_FG};${ACCENT};#3D8BFD;#8B5CF6;#2AA9A0;#C8C8CC"
	TERM_PALETTE="${TERM_PALETTE};#4A4A50;#FF6B6F;${TERM_FG_HI};${ACCENT_HI};#6EA8FE;#A78BFA;#4FD6CC;#FFFFFF"
fi

if [[ "$MODE" == "clair" ]]; then
	# Thème de jour : blanc cassé/crème, jamais blanc pur — texte noir.
	BG="#F7F5F0"
	BG_ALT="#EFEBE3"
	BG_HI="#E5DFD3"
	BORDER="#D9D2C3"
	FG="#1B1A17"
	FG_DIM="#6B675E"
	#  Le haut des fenêtres. De jour il reste le crème du reste : le gris
	#  demandé pour la nuit y ferait une bande sombre sur un bureau clair —
	#  la même règle, retranscrite pour un fond clair, comme pour le terminal.
	HEADER="$BG_ALT"
else
	#  ═══ LexOS Noir : PLUS TOUT À FAIT LE NOIR PUR — DEMANDE D'ALEX ═══
	#  Le fond des fenêtres était #000000, et le commentaire d'à côté disait
	#  « Alex n'a jamais demandé à le changer ». Il vient de le demander : sur
	#  trois gris rendus côte à côte, il a choisi #121214.
	#
	#  L'ÉCHELLE BOUGE EN ENTIER, ET C'EST LE POINT QUI COMPTE. Monter BG seul
	#  l'aurait amené à un cheveu de BG_HI (#141416) : le survol d'un fichier
	#  serait devenu invisible — mesuré, 1,02 de contraste entre les deux, soit
	#  rien du tout. Les quatre valeurs montent donc ensemble, en gardant les
	#  écarts d'aujourd'hui :
	#      fond → survol   1,14 avant, 1,18 après
	#      fond → bordure  1,34 avant, 1,40 après
	#  Le blanc du texte reste largement au-dessus du seuil : 18,7 contre 21.
	#
	#  CE QUI NE BOUGE PAS, ET POURQUOI : TERM_BG (le terminal garde son noir,
	#  c'est un réglage séparé avec son propre jour/nuit) et le fond de la
	#  barre du haut dans gtk-panneau.css (Alex a demandé le noir franc pour
	#  elle, explicitement).
	BG="#121214"
	BG_ALT="#191A1D"
	BG_HI="#212226"
	BORDER="#2E2F34"
	FG="#FFFFFF"
	FG_DIM="#B8B8BC"
	#  ═══ LE HAUT DES FENÊTRES — DEMANDE D'ALEX ═══
	#  « En haut du navigateur il est trop noir, changer pour qu'il soit un
	#  peu gris » — puis, sur trois gris rendus côte à côte : « 3e, aime bien
	#  gris ». #26262B.
	#
	#  ET IL EST ICI, PAS DANS UN RÉGLAGE DE CHROMIUM. C'est la deuxième
	#  moitié de sa demande : « pour pas avoir à changer les couleurs et tout
	#  le kit sur chaque appli ». Écrit dans le thème, le gris vaut pour TOUS
	#  les hauts de fenêtre — et Chromium, qui lit les couleurs GTK, le prend
	#  tout seul. Mesuré : la bande d'onglets rend #26262B sans qu'on lui
	#  pose quoi que ce soit dans son profil.
	#
	#  ═══ CE GRIS-CI ATTEND UNE DÉCISION D'ALEX — NE PAS TRANCHER SEUL ═══
	#  #26262B a été choisi À L'ŒIL, sur photo, contre un fond NOIR PUR :
	#  « un cran au-dessus du fond ». Le fond ayant monté à #121214, ce cran
	#  s'est réduit à un demi — mesuré : 1,39 de contraste avec l'ancien fond,
	#  1,24 avec le nouveau. Et contre le survol des fenêtres il tombe à 1,06,
	#  c'est-à-dire qu'il s'y confond.
	#
	#  #2F2F35 rétablirait exactement l'écart d'origine : 1,41 contre le fond,
	#  1,19 contre le survol — les mêmes chiffres qu'avant le changement.
	#
	#  MAIS ON NE LE POSE PAS D'AUTORITÉ. Cette couleur-là a été choisie à
	#  l'œil et pas calculée ; les deux rendus lui ont été envoyés côte à côte,
	#  et cette ligne changera quand il aura dit lequel. En attendant, la
	#  valeur qu'il connaît reste en place — livrer une couleur qu'il n'a pas
	#  vue serait pire que livrer celle qu'il a déjà validée.
	HEADER="#26262B"
fi

mkdir -p "$CONF_DIR" "$TARGET/.config/gtk-3.0" "$TARGET/.config/gtk-4.0" \
         "$TARGET/.config/xfce4/terminal"
printf '%s\n' "$ACCENT_NAME" > "$CONF_DIR/accent"
printf '%s\n' "$MODE" > "$CONF_DIR/mode"
printf '%s\n' "$TERM_MODE" > "$CONF_DIR/terminal-mode"

# =============================================================================
#  1. Feuille de style GTK 3
# =============================================================================
#  LE STYLE DU PANNEAU VIENT DU SQUELETTE, ET IL SURVIT.
#  RÉGRESSION TROUVÉE PAR L'AUDIT DU 22 AOÛT : ce générateur écrasait
#  ~/.config/gtk-3.0/gtk.css par simple redirection, et sa sortie ne
#  contenait AUCUNE règle #XfcePanelWindow. Le squelette livrait la barre
#  arrondie, les points des bureaux, les notifications — et lexos-firstrun
#  détruisait tout ça à la PREMIÈRE ouverture de session, sans une erreur.
#  Le fichier était dans l'ISO, installé, et mort avant d'avoir servi.
#
#  La source de vérité est /usr/share/lexos/gtk-panneau.css — présent sur
#  toute machine LexOS. On le recopie EN TÊTE de la sortie, en traduisant
#  l'accent : le orange par défaut (#E8590C, #FF7A33, #A84007 et le triplet
#  rgba « 232, 89, 12 ») devient l'accent choisi. Si le squelette manque
#  (machine non-LexOS), on le dit dans le CSS et on continue : on perd le
#  panneau stylé, pas le thème entier.
bloc_panneau() {
	#  Surchargeable pour être ÉPROUVABLE hors ISO — même procédé que
	#  LEXOS_ICONES plus bas : sans ça, ce bloc ne se vérifie qu'en
	#  construisant et démarrant une image.
	#  ═══ CE FICHIER N'EST PLUS DANS /etc/skel, ET C'EST CAPITAL ═══
	#  Il y a vécu longtemps, et ça se tenait tant que la feuille de LexOS
	#  était elle-même un fichier d'utilisateur. Depuis l'étape 4, non :
	#  tout ce qui est dans /etc/skel/.config/gtk-3.0/ ARRIVE dans le
	#  ~/.config de chaque compte, où GTK le charge en priorité UTILISATEUR.
	#  Le laisser là aurait rendu aux applications le poids qu'on vient de
	#  leur retirer — l'étape 4 annulée sur la vraie machine, tous les bancs
	#  restant verts, parce qu'ils travaillent dans un foyer neuf où
	#  /etc/skel n'a pas été recopié.
	#
	#  Il est donc dans /usr/share/lexos : une ENTRÉE du générateur, jamais
	#  un fichier d'utilisateur. Un contrôle de CI interdit désormais qu'un
	#  gtk.css réapparaisse sous etc/skel/.config.
	local squelette="${LEXOS_PANNEAU_CSS:-/usr/share/lexos/gtk-panneau.css}"
	if [[ ! -r "$squelette" ]]; then
		printf '/* squelette %s illisible : style du panneau non repris */\n' "$squelette"
		return 0
	fi
	printf '/* --- Style du panneau, repris du squelette (accent : %s) --- */\n' "$ACCENT_NAME"
	sed -e "s/#E8590C/${ACCENT}/gI" \
	    -e "s/#FF7A33/${ACCENT_HI}/gI" \
	    -e "s/#A84007/${ACCENT_LO}/gI" \
	    -e "s/232, 89, 12/${r}, ${g}, ${b}/g" \
	    "$squelette"
	printf '\n/* --- Fin du bloc squelette --- */\n'
}

gen_gtk_css() {
bloc_panneau
cat <<EOF
/* =========================================================================
   LexOS Noir — accent : ${ACCENT_NAME} (${ACCENT})
   Généré par lexos-theme-gen. Ne pas éditer : sera écrasé.
   ========================================================================= */

@define-color lexos_accent      ${ACCENT};
@define-color lexos_accent_hi   ${ACCENT_HI};
@define-color lexos_accent_lo   ${ACCENT_LO};
@define-color lexos_bg          ${BG};
@define-color lexos_bg_alt      ${BG_ALT};
@define-color lexos_fg          ${FG};

@define-color theme_bg_color            ${BG};
@define-color theme_base_color          ${BG};
@define-color theme_fg_color            ${FG};
@define-color theme_text_color          ${FG};
@define-color theme_selected_bg_color   ${ACCENT};
@define-color theme_selected_fg_color   ${BTN_FG};
@define-color insensitive_bg_color      ${BG_ALT};
@define-color insensitive_fg_color      ${FG_DIM};
@define-color borders                   ${BORDER};
@define-color unfocused_borders         ${BORDER};
@define-color accent_color              ${ACCENT};
@define-color accent_bg_color           ${ACCENT};
@define-color accent_fg_color           ${BTN_FG};
@define-color window_bg_color           ${BG};
@define-color window_fg_color           ${FG};
@define-color view_bg_color             ${BG};
@define-color view_fg_color             ${FG};
@define-color headerbar_bg_color        ${HEADER};
@define-color headerbar_fg_color        ${FG};
@define-color popover_bg_color          ${BG_ALT};
@define-color popover_fg_color          ${FG};

/* --- Fonds : noir pur, MAIS SEULEMENT SUR LES VRAIES SURFACES -----------
   ALEX, PHOTO DE LA LOGITHÈQUE : « encore dans des carrés noirs — écriture ».
   Les tuiles de catégorie (Jouer, Développer, Travailler…) portent un beau
   dégradé coloré, et par-dessus, un RECTANGLE NOIR opaque contenant l'icône
   et le texte. C'était nous.

   ═══ LA CAUSE, VÉRIFIÉE SUR LE VRAI BINAIRE ═══
   « strings /usr/bin/gnome-software » livre le gabarit de la tuile :

       <template class="GsCategoryTile" parent="GtkFlowBoxChild">
         <style><class name="card"/><class name="category-tile"/></style>
         <child><object class="GtkBox" id="box">
           <child><object class="GtkImage" id="image"/></child>
           <child><object class="GtkLabel" id="label"/></child>

   La tuile est un GtkFlowBoxChild — PAS un GtkButton. Le dégradé est peint
   par gnome-software sur « .card.category-tile » ; la « box » qui tient
   l'icône et le libellé est un simple nœud de MISE EN PAGE, transparent chez
   tout le monde. Cette règle la peignait en noir opaque : un rectangle noir
   estampé sur le dégradé, exactement la photo.

   ═══ POURQUOI L'EXCEPTION EXISTANTE NE COUVRAIT PAS LE CAS ═══
   Un correctif plus bas rend transparents les descendants d'un BOUTON, et
   seulement eux — il énumère ses nœuds un à un. Le parent est ici un
   flowboxchild : la règle ne mordait pas, et personne ne pouvait le voir en
   lisant la feuille — il fallait connaître l'arbre de widgets de l'appli.

   ═══ LE CORRECTIF ═══
   On sépare les VRAIES SURFACES (une fenêtre, une liste, une vue : des
   choses qui ont légitimement un fond) des NŒUDS DE MISE EN PAGE (box,
   grid, overlay, flowbox, viewport, frame, stack : des boîtes qui ne font
   que placer leurs enfants). Les premières restent noires ; les secondes
   deviennent TRANSPARENTES.

   Transparent, et pas simplement absent : l'intention d'origine était de
   battre le fond que le thème de base dessine, et « transparent » l'écrase
   tout aussi fort que « noir » — sans estamper de couleur. Sur une fenêtre
   ordinaire le rendu ne bouge pas d'un pixel : la fenêtre est noire, et les
   boîtes laissent voir ce noir au travers. Sur une tuile colorée, le dégradé
   se voit enfin. */
window, dialog, .background, popover, popover.background,
notebook, notebook > stack, paned, scrolledwindow,
list, listbox, .view, textview,
treeview.view, iconview, assistant, messagedialog {
    background-color: ${BG};
    color: ${FG};
}

/* --- LE BUREAU N'EST PAS UNE FENETRE ------------------------------------ */
/*  ALEX, DEUX PHOTOS : « quand je clique sur le bouton droit de la souris,
    il devient tout noir ». Une icone du bureau choisie porte une tuile
    orange ; des que le menu du clic droit s'ouvre, la tuile disparait dans
    le noir et il ne reste que le libelle.

    ═══ LA CAUSE, RELEVEE DANS LE BINAIRE DE XFDESKTOP ═══
    xfdesktop embarque SA feuille de style, qu'on a lue dans le binaire
    (« strings /usr/bin/xfdesktop ») plutot que devinee :

        XfdesktopIconView.view          { background: transparent; … }
        XfdesktopIconView.view:active   { background: alpha(@theme_selected_bg_color, 0.5); }

    Sa vue est donc TRANSPARENTE au repos — c'est ce qui laisse voir le fond
    d'ecran entre les icones — et la tuile choisie est l'accent a moitie.

    Or ce noeud porte la classe « view », et la regle juste au-dessus liste
    « .view » parmi tout ce qui doit etre noir. Notre feuille est chargee en
    priorite UTILISATEUR, celle de xfdesktop en priorite APPLICATION : la
    notre gagne, sur TOUS les etats. Mesure sur un vrai GTK 3.24, les deux
    feuilles chargees a leurs vraies priorites :

        XfdesktopIconView.view  au repos ............ #000000 a=1,00
        XfdesktopIconView.view  choisie (:active) ... #000000 a=1,00
        XfdesktopIconView.view  choisie + backdrop .. #000000 a=1,00

    Un noir OPAQUE la ou xfdesktop veut du transparent. C'est le meme defaut
    que le rectangle de selection de Thunar, rejoue sur le bureau : une regle
    ecrite pour les listes qui attrape au passage un noeud qui n'en est pas
    une.

    ═══ CE QU'ON ECRIT A LA PLACE ═══
    On rend la vue transparente — c'est le bureau, on doit voir le fond
    d'ecran — et on dit NOUS-MEMES la couleur de la tuile choisie, dans les
    QUATRE etats ou elle peut se trouver. « :active » et « :selected » parce
    que xfdesktop emploie l'un ou l'autre selon sa version ; « :backdrop »
    parce que c'est exactement l'etat dans lequel le bureau passe quand le
    menu du clic droit s'ouvre — et une regle qui oublie le backdrop est une
    regle qui s'eteint des qu'on clique ailleurs.

    L'accent PLEIN et non a moitie : a 50 % sur un fond d'ecran sombre, la
    tuile de xfdesktop rend un orange eteint. Alex la voit orange vif sur sa
    photo, et c'est ce qu'on garde. */
XfdesktopIconView,
XfdesktopIconView.view {
    background-color: transparent;
}
XfdesktopIconView.view:active,
XfdesktopIconView.view:active:backdrop,
XfdesktopIconView.view:active:hover,
XfdesktopIconView.view:selected,
XfdesktopIconView.view:selected:backdrop,
XfdesktopIconView.view:selected:hover {
    background-color: ${ACCENT};
    color: ${BTN_FG};
    border-radius: 8px;
}
XfdesktopIconView.view .label:active,
XfdesktopIconView.view .label:active:backdrop,
XfdesktopIconView.view .label:selected,
XfdesktopIconView.view .label:selected:backdrop {
    color: ${BTN_FG};
}
XfdesktopIconView .rubberband {
    background-color: alpha(${ACCENT}, 0.20);
    border: 1px solid ${ACCENT};
}

/*  LES NŒUDS DE MISE EN PAGE NE PEIGNENT RIEN. Ils gardent la couleur de
    texte — sinon le libellé d'une boîte perdrait le blanc — mais laissent
    voir ce qu'il y a derrière, fenêtre noire ou tuile colorée. */
box, grid, viewport, frame, flowbox, stack, overlay {
    background-color: transparent;
    color: ${FG};
}

/*  LE HAUT DES FENÊTRES est le seul endroit qui prend ${HEADER} et non
    ${BG_ALT} : de nuit, un gris franc un cran au-dessus du noir. Voir la
    palette en tête de fichier — et c'est aussi ce que Chromium lit pour sa
    bande d'onglets, sans un seul réglage de son côté. */
headerbar, .titlebar, toolbar, actionbar, searchbar, infobar,
.csd .titlebar, menubar, .menubar {
    background-color: ${HEADER};
    background-image: none;
    color: ${FG};
    border-color: ${BORDER};
}

/* --- Écriture blanche partout ------------------------------------------- */
label, .label, textview text, entry, spinbutton, checkbutton, radiobutton,
menuitem, .menuitem, treeview.view, cellrenderertext {
    color: ${FG};
}
label:disabled, .dim-label, .subtitle { color: ${FG_DIM}; }

/* --- Boutons : accent, SANS peindre le « button » nu ---------------------
   Le sélecteur « button » tout nu perdait contre Arc-Dark partout où celui-ci
   est plus précis (des boutons restaient sombres), ET il arrosait les faux
   boutons — listes déroulantes, compteurs, en-têtes de colonnes devenaient
   orange (vu sur la photo d'Alex : le Gestionnaire d'alimentation avec ses
   listes en gros orange). On énumère donc les contextes RÉELS, et on exclut
   plus bas les boutons de structure. */
window button, dialog button, messagedialog button,
headerbar button, .titlebar button, toolbar button, actionbar button,
popover button, infobar button, .dialog-action-area button,
.linked > button {
    background-image: none;
    background-color: ${ACCENT};
    color: ${BTN_FG};
    border: 1px solid ${ACCENT_LO};
    border-radius: 6px;
    text-shadow: none;
    /*  ALEX, PHOTO DE LA 73 : « fais le texte plus gros dans les boutons
        orange — noir, mais un petit peu plus gras, il est trop mince. »
        Le rectangle noir avait disparu, et c'est justement là que le vrai
        problème s'est vu : le libellé était en graisse normale, à la taille
        du texte courant, sur un aplat de couleur vive. Un texte fin sur de
        l'orange se lit moins bien que le même texte sur du noir — l'œil perd
        le contour des lettres dans la vibration du fond.
        600 et non 700 : « un petit peu ». Le gras franc alourdit une rangée
        de quatre boutons.
        1.06em et non un chiffre en pixels : le texte doit suivre « lexos
        access gros-texte » et le facteur d'écran. Une taille figée ici
        annulerait l'agrandissement là où il sert le plus. */
    font-weight: 600;
    font-size: 1.06em;
    /*  Le rembourrage suit la taille, sinon le texte touche la bordure. */
    padding: 6px 16px;
    transition: background-color 140ms ease-out, border-color 140ms ease-out;
}
window button:hover, dialog button:hover, headerbar button:hover,
toolbar button:hover, popover button:hover {
    background-color: ${ACCENT_HI};
    border-color: ${ACCENT};
}
window button:active, window button:checked,
dialog button:active, dialog button:checked {
    background-color: ${ACCENT_LO};
    border-color: ${ACCENT_LO};
}
window button:disabled, dialog button:disabled {
    background-color: ${BG_HI};
    color: ${FG_DIM};
    border-color: ${BORDER};
}

/* --- LE TEXTE DU BOUTON, ET LE NOIR QUI TRAÎNAIT DERRIÈRE -----------------
   PHOTO D'ALEX, FENÊTRE DE BIENVENUE : « il y a du noir sur les boutons
   orange (…) bouton orange et le texte en noir ». Le libellé était posé sur
   un rectangle noir à l'intérieur du bouton, au lieu d'être écrit à même
   l'orange.

   DEUX CAUSES, ET ELLES SONT DANS CE FICHIER.

   1. « color: ${FG} » PLUS HAUT ARROSE TOUS LES LIBELLÉS, y compris ceux qui
      sont DANS un bouton. Le bouton demandait bien ${BTN_FG} (noir, calculé
      pour donner 6,1:1 sur l'orange) — mais son enfant « label » portait sa
      propre couleur blanche, et un enfant qui a sa couleur n'hérite pas.
      Le sélecteur « label » est un type, il gagne sur l'héritage sans même
      avoir à être plus précis. D'où du texte BLANC sur orange : 3,4:1, sous
      le seuil lisible, et pas ce qu'Alex a demandé.

   2. LES ENFANTS DU BOUTON GARDAIENT LEUR FOND. GTK bâtit un bouton comme
      button > label, ou button > box > (image + label). Peindre le bouton ne
      repeint pas ses enfants : le fond sombre que le thème de base dessine
      sur la boîte interne restait, et c'est LUI le rectangle noir de la
      photo. On le retire explicitement.

   « inherit » plutôt que ${BTN_FG} en dur : les boutons de STRUCTURE plus bas
   demandent ${FG} et leurs libellés doivent suivre CE choix-là. Une couleur
   écrite en dur ici les casserait tous. */
/*  ═══ CE QUE LA PREMIÈRE VERSION DE CE CORRECTIF A RATÉ ═══
    Elle énumérait « button > label, button > box, button > box > label… » —
    des combinateurs ENFANT, à une profondeur devinée. Deux choses lui ont
    échappé, et la seconde annulait tout le correctif.

    1. LA PROFONDEUR N'EST PAS CONNUE D'AVANCE. Un bouton texte seul, c'est
       « button > label ». Un bouton icône+texte, c'est « button > box >
       label ». D'autres formes ajoutent une box de plus, ou une grid. Une
       énumération d'enfants directs rate tout ce qui est un cran plus bas :
       le fond noir y reste, et c'est le rectangle de la photo d'Alex.

    2. « color: inherit » HÉRITE DU PARENT DIRECT, PAS DU BOUTON. Et le
       parent direct du libellé, dès qu'il y a une icône, c'est la box — à
       qui la règle des fonds (« box, grid » plus haut) donne EXPLICITEMENT
       color: #FFFFFF. Le libellé héritait donc du BLANC de la box, pas du
       noir du bouton. Mesuré : blanc sur l'orange = 3,58:1, très exactement
       le défaut que ce correctif prétendait réparer. Il était livré, lu par
       GTK, et sans effet — le péché capital de ce projet, commis en le
       corrigeant.

    D'où le combinateur de DESCENDANCE, qui ne présume d'aucune profondeur,
    et « color: inherit » posé AUSSI sur box/grid : la couleur du bouton
    descend alors de proche en proche jusqu'au libellé, quel que soit le
    nombre d'étages. Spécificité 0,0,2 contre 0,0,1 pour la règle des fonds :
    on gagne quelle que soit la position dans la feuille. */
button label, button box, button grid, button image,
button stack, button widget, button contents {
    background-image: none;
    background-color: transparent;
    box-shadow: none;
    border: none;
    color: inherit;
    text-shadow: none;
    /*  LA GRAISSE ET LA TAILLE SE TRANSMETTENT COMME LA COULEUR, et pour la
        même raison : un enfant qui porte les siennes n'hérite pas de celles
        du parent. Sans ces deux lignes, le bouton demanderait du 600 et son
        libellé resterait fin — exactement le piège de « color: inherit »,
        rejoué sur une autre propriété. */
    font-weight: inherit;
    font-size: inherit;
}

/* --- Les boutons de STRUCTURE ne sont pas des boutons --------------------
   Une liste déroulante, une flèche de compteur, un en-tête de colonne, un
   bouton de barre de chemin : GTK les bâtit avec des « button » internes,
   mais personne ne les voit comme des boutons. Ils reprennent l'habit d'un
   champ : fond sombre, liseré discret. Ces règles viennent APRÈS celles de
   l'accent et les battent à spécificité égale ou supérieure. */
combobox button, combobox button.combo, spinbutton button,
treeview header button, header button, .path-bar button, pathbar button,
scrollbar button, calendar button, filechooser .path-bar button {
    background-image: none;
    background-color: ${BG_ALT};
    color: ${FG};
    border: 1px solid ${BORDER};
    border-radius: 6px;
}
combobox button:hover, spinbutton button:hover,
treeview header button:hover, .path-bar button:hover {
    background-color: ${BG_HI};
    border-color: ${ACCENT_LO};
}

/* --- Interrupteurs : l'accent, pas le bleu du thème de base --------------
   Vu sur la photo d'Alex : des interrupteurs BLEUS (Arc-Dark) au milieu
   d'un panneau orange. L'état « allumé » parle la langue de la maison. */
switch {
    background-color: ${BG_HI};
    border: 1px solid ${BORDER};
    border-radius: 999px;
}
switch:checked {
    background-color: ${ACCENT};
    border-color: ${ACCENT_LO};
}
switch slider {
    background-color: #FFFFFF;
    border-radius: 999px;
}
/*  Un bouton d'icône TRANSPARENT sur fond noir pur est invisible tant
    qu'on ne le survole pas — « une boîte sombre avec juste le logo au
    centre », dans les mots d'Alex. Fond très léger et liseré discret :
    visible sans être criard. */
button.flat, button.titlebutton, button.close, button.minimize,
button.maximize, notebook button, .titlebar button.titlebutton {
    background-color: ${BG_HI};
    border: 1px solid ${BORDER};
    border-radius: 6px;
    color: ${FG};
}
button.flat:hover, button.titlebutton:hover {
    background-color: ${BG_HI};
    border-color: ${BORDER};
}
/*  CES DEUX-LÀ POSAIENT UN FOND SANS COULEUR DE TEXTE, et récupéraient donc
    celle de l'accent : sur un accent bleu, du blanc atterrissait sur le rouge
    du bouton de suppression — 3,9:1, sous le seuil. Chacun porte maintenant
    la sienne, calculée sur SON fond. */
button.destructive-action, button.destructive-action label {
    background-color: ${DANGER};
    color: ${DANGER_FG};
    border-color: #A32B2F;
}
button.destructive-action label { background-color: transparent; }
button.suggested-action, button.suggested-action label {
    background-color: ${ACCENT};
    color: ${BTN_FG};
    border-color: ${ACCENT_LO};
}
button.suggested-action label { background-color: transparent; }

/* --- Champs de saisie ---------------------------------------------------- */
entry, spinbutton, .entry, searchbar entry {
    background-color: ${BG_ALT};
    color: ${FG};
    border: 1px solid ${BORDER};
    border-radius: 6px;
    caret-color: ${ACCENT};
}
entry:focus, spinbutton:focus {
    border-color: ${ACCENT};
    box-shadow: inset 0 0 0 1px ${ACCENT};
}
/*  UNE SEULE REGLE, ET « ::selection » A ETE RETIRE.
    Elles etaient ecrites « selection, ::selection { … } » : un selecteur
    invalide dans une liste invalide la REGLE ENTIERE, et la selection de
    texte restait BLEUE, celle d'Arc-Dark. On les avait donc separees, en
    laissant « ::selection » de cote « ignore tout seul ».

    IL N'ETAIT PAS IGNORE TOUT SEUL. Mesure sur un vrai GTK 3.24 :
    gtk_css_provider_load_from_path() a deux comportements selon que
    l'appelant demande l'erreur ou non. Sans pointeur d'erreur (le cas de
    GTK quand il lit ~/.config/gtk-3.0/gtk.css), il ecrit un
    avertissement et garde le reste. AVEC pointeur d'erreur, il REMET LA
    FEUILLE A ZERO : tout le theme de LexOS disparait, y compris les
    regles ECRITES AVANT. Mesure : la couleur de « window » retombait au
    #F6F5F4 d'Adwaita au lieu du noir.

    Autrement dit, ce bloc ne servait a rien (GTK3 comme GTK4 emploient le
    noeud « selection », jamais « ::selection ») et il posait une mine
    sous chaque outil qui lit notre feuille en demandant les erreurs — un
    banc d'essai, par exemple. Il salissait aussi la sortie de chaque
    application GTK : « Theme parsing error: gtk.css:603:1 ». */
selection {
    background-color: ${ACCENT};
    color: ${BTN_FG};
}

/* --- LE RECTANGLE DE SELECTION (le « caoutchouc ») ----------------------- */
/*  PHOTO D'ALEX, ISO 74, THUNAR : en tirant un cadre pour prendre plusieurs
    dossiers d'un coup, le rectangle est un BLOC NOIR OPAQUE a bord bleu. Il
    cache ce qu'on est en train de selectionner — c'est-a-dire exactement ce
    qu'on regarde. « pourrais-tu faire qu'il soit transparent a la place ».

    ═══ D'OU VIENT LE NOIR, ET CE N'EST PAS UNE HYPOTHESE ═══
    Les deux feuilles ont ete lues. Arc-Dark ecrit (common/gtk-3.0, _common.scss) :

        rubberband, .rubberband {
          border:           1px solid  <bleu de selection, assombri de 10 %>
          background-color: <le meme, rendu transparent a 80 %>
        }

    (Les noms de variables SCSS d'Arc sont volontairement recrits en clair
    ici : ce commentaire vit dans un heredoc non protege, ou un « dollar
    quelque-chose » serait DEVELOPPE par le shell. Avec « set -u », une
    variable inconnue arrete meme la generation du theme. Le copier-coller
    d'un extrait de code etranger dans ce fichier n'est jamais innocent —
    shellcheck l'a attrape ici.)

    donc un fond a 20 % d'opacite et un bord bleu. Le bord bleu de la photo
    EST celui-la : la regle d'Arc s'applique bien.

    Pendant le trace, GTK ne cree pas un noeud « rubberband » a part : il
    reprend le contexte de la VUE et lui AJOUTE la classe .rubberband. Le
    noeud porte donc a la fois « iconview », « .view » et « .rubberband ».
    Or notre regle des fonds, plus haut, liste « .view » :

        … .view, textview, treeview.view, iconview … { background-color: BG; }

    « .view » pese (0,1,0). « .rubberband » d'Arc pese (0,1,0) aussi. Egalite
    de specificite — et a egalite, c'est la feuille LUE EN DERNIER qui gagne.
    La notre est chargee apres le theme. Notre fond opaque ecrase donc le fond
    transparent d'Arc, et seul son bord survit, faute qu'on y touche.

    C'est mot pour mot la panne des boutons de la 72 : une regle large qui
    peint quelque chose qu'elle n'avait pas en tete.

    ═══ POURQUOI CES SELECTEURS-LA ═══
    Il ne suffit PAS d'ecrire « rubberband » : ce selecteur d'element pese
    (0,0,1) et perdrait contre notre propre « .view » (0,1,0) sur ce meme
    noeud. Il faut passer AU-DESSUS de (0,1,0) :
        .view.rubberband        (0,2,0)
        iconview.rubberband     (0,1,1)
        treeview.view.rubberband(0,2,1)
    Les deux formes nues sont gardees en plus, pour les vues qui ne portent
    pas .view (flowbox, certaines listes) ou creent un vrai noeud a part.

    ═══ ET POURQUOI DES REGLES SEPAREES ═══
    Meme lecon que « selection, ::selection » vingt lignes plus haut : un
    selecteur invalide dans une liste separee par des virgules invalide la
    REGLE ENTIERE. Si une version de GTK cessait de reconnaitre l'une de ces
    formes, une liste unique les emporterait toutes et le rectangle
    redeviendrait noir. Separees, chacune tombe ou tient toute seule.

    ═══ ET POURQUOI rgba() PLUTOT QUE alpha() ═══
    GTK connait « alpha(couleur, 0.25) », mais si une version ne la
    comprenait pas, la declaration serait ignoree et le fond retomberait sur
    notre BG opaque — on aurait « corrige » le defaut en le laissant intact.
    Le triplet est donc calcule ici, en clair : aucune fonction a
    interpreter, aucun repli silencieux possible. C'est deja la convention
    du squelette (« 232, 89, 12 »). */
.view.rubberband {
    background-color: rgba(${r}, ${g}, ${b}, 0.25);
    border: 1px solid ${ACCENT};
}
iconview.rubberband {
    background-color: rgba(${r}, ${g}, ${b}, 0.25);
    border: 1px solid ${ACCENT};
}
treeview.view.rubberband {
    background-color: rgba(${r}, ${g}, ${b}, 0.25);
    border: 1px solid ${ACCENT};
}
flowbox.rubberband {
    background-color: rgba(${r}, ${g}, ${b}, 0.25);
    border: 1px solid ${ACCENT};
}
.rubberband {
    background-color: rgba(${r}, ${g}, ${b}, 0.25);
    border: 1px solid ${ACCENT};
}
rubberband {
    background-color: rgba(${r}, ${g}, ${b}, 0.25);
    border: 1px solid ${ACCENT};
}

/* --- Sélection dans les listes ------------------------------------------ */
row:selected, list row:selected, treeview.view:selected,
menuitem:hover, .menuitem:hover {
    background-color: ${ACCENT};
    color: ${BTN_FG};
}
/*  ET LA MEME CHOSE DANS TOUS LES ETATS DE LA LIGNE.
    La regle du dessus pese (0,2,1) pour « treeview.view:selected ». Celle de
    la grille, plus bas, doit employer « .view:selected » nu — c'est le SEUL
    selecteur qui atteigne la vue en icones de Thunar (mesure : ni
    « ExoIconView:selected » ni « .standard-view:selected » ne la touchent).
    Or « .view:selected:focus » pese (0,3,0) : des qu'une ligne de LISTE prend
    le focus, le gris de la grille lui passerait devant. Mesure avant ce
    renfort, sur « treeview.view » :

        choisi ............... #E8590C   (l'accent, voulu)
        choisi + focus ....... #C4C8D0   (le gris de la grille, PAS voulu)
        choisi + backdrop .... #C4C8D0

    Une ligne qui change de couleur selon qu'on l'a cliquee ou non. On repose
    donc l'accent avec le nom du noeud, ce qui remet la balance a (0,3,1). */
treeview.view:selected:focus, treeview.view:selected:hover,
treeview.view:selected:backdrop, treeview.view:selected:focus:backdrop,
row:selected:focus, row:selected:backdrop,
list row:selected:focus, list row:selected:backdrop {
    background-color: ${ACCENT};
    color: ${BTN_FG};
}

/* --- LA GRILLE D'APPLICATIONS FAIT EXCEPTION --------------------------- */
/*  ALEX, capture de la Liste des applications : « la couleur de
    l'application une fois sélectionnée, il faudrait que le carré orange
    reste de couleur gris pâle », « au lieu de faire tout un carré orange ».

    Ailleurs, l'accent sur la sélection est juste : une ligne de liste est un
    ruban fin, l'accent la souligne. Ici c'est une TUILE de 190 px qui porte
    déjà une icône colorée — un aplat d'accent de cette taille écrase le
    dessin qu'on est justement en train de choisir, et il n'y en a qu'un à la
    fois : personne ne peut le confondre avec autre chose.

    Un gris pâle et des coins arrondis suffisent à dire « celle-ci », sans
    repeindre le quart de l'écran. Le texte suit texte_lisible(), la même
    fonction WCAG que partout ailleurs : sur ce gris-là elle rend du noir, et
    le libellé reste lisible — en blanc il aurait disparu. */
/*  ═══ ET THUNAR EN FAIT PARTIE — MAIS PAS PAR LE NŒUD QU'ON CROYAIT ═══
    ALEX, DEUX PHOTOS DE THUNAR : le dossier choisi devenait une SILHOUETTE
    NOIRE, icone comprise ; et « on pourrait ajouter un gris pâle à la place
    de tout le mettre orange ».

    LES DEUX ONT LA MEME CAUSE, TROUVEE EN LANÇANT LE VRAI THUNAR SOUS XVFB
    ET EN SONDANT SELECTEUR PAR SELECTEUR (magenta vif, capture, comptage
    des pixels) :

        ExoIconView:selected ....... rien
        .standard-view:selected .... rien
        .view:selected ............. TEINTE

    Thunar TEINTE l'icone choisie avec la couleur de fond lue a l'etat
    « selected » sur le noeud de classe « view ». Notre feuille n'avait
    AUCUNE regle « .view:selected » : la lecture retombait donc sur la regle
    des fonds, ou « .view » vaut le noir de LexOS. D'ou une icone noire sur
    fond noir — le dossier disparaissait.

    L'ancienne regle du squelette visait « .thunar iconview:selected » et
    « iconview.view:selected ». Mesure : elle ne teintait RIEN. La vue de
    Thunar ne porte pas le noeud « iconview » (c'est une ExoIconView), et
    personne ne s'en etait apercu parce que la couleur avait l'air d'exister.
    Meme lecon que XfdesktopIconView, un ecran plus loin.

    Le gris pale sert donc DEUX choses d'un coup : la tuile ne repeint plus
    le quart de l'ecran en orange, et l'icone teintee de ce gris reste
    parfaitement lisible. */
iconview:selected, iconview:selected:focus,
flowboxchild:selected, flowboxchild:selected:focus,
iconview .cell:selected,
.view:selected, .view:selected:focus,
.thunar .standard-view:selected,
ExoIconView:selected, ExoIconView .cell:selected {
    background-color: ${SEL_GRILLE};
    color: ${SEL_GRILLE_TXT};
    border-radius: 10px;
}
/*  ET EN « BACKDROP » — l'etat ou passe la vue quand le menu du clic droit
    prend la main. Une regle qui l'oublie s'eteint au moment precis ou on
    regarde : c'est le meme oubli qui noircissait l'icone du bureau. */
iconview:selected:backdrop, flowboxchild:selected:backdrop,
iconview .cell:selected:backdrop,
.view:selected:backdrop,
.thunar .standard-view:selected:backdrop,
ExoIconView:selected:backdrop, ExoIconView .cell:selected:backdrop {
    background-color: ${SEL_GRILLE};
    color: ${SEL_GRILLE_TXT};
    border-radius: 10px;
}
row:hover, list row:hover { background-color: ${BG_HI}; }

/* --- Barres de défilement ------------------------------------------------ */
scrollbar { background-color: ${BG}; border-color: ${BORDER}; }
