#!/usr/bin/env bash
# =============================================================================
#  lexos-install — lance l'installation sur disque, APRÈS confirmation explicite
# =============================================================================
#  Règle de la maison : on essaie d'abord LexOS depuis la clé USB (mode démo),
#  et on ne touche au disque dur que si l'utilisateur le demande clairement.
#  Ce script ne formate rien lui-même : il vérifie, avertit, puis passe la main
#  à Calamares qui gère le partitionnement.
# =============================================================================
set -uo pipefail

FORCE=0
for a in "$@"; do
	[[ "$a" == "--yes" || "$a" == "-y" ]] && FORCE=1
done

if [[ -t 1 ]]; then
	O=$'\033[38;5;208m'; E=$'\033[31m'; Y=$'\033[33m'; B=$'\033[1m'; R=$'\033[0m'
else
	O=''; E=''; Y=''; B=''; R=''
fi

NAME="LexOS"; VER="1.0"
if [[ -r /etc/os-release ]]; then
	# shellcheck disable=SC1091
	. /etc/os-release
	NAME="${NAME:-LexOS}"; VER="${VERSION_ID:-1.0}"
fi

# --- Sommes-nous en session démo (live) ? -----------------------------------
IS_LIVE=0
grep -qa 'boot=live' /proc/cmdline 2>/dev/null && IS_LIVE=1

# --- Sur quel support tourne-t-on ? -----------------------------------------
boot_media() {
	local src
	src="$(findmnt -no SOURCE / 2>/dev/null || true)"
	if [[ "$IS_LIVE" -eq 1 ]]; then
		local dev
		dev="$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)"
		[[ -n "$dev" ]] && { printf '%s' "$dev"; return; }
	fi
	printf '%s' "${src:-inconnu}"
}

# --- Liste des disques qui seraient concernés -------------------------------
list_disks() {
	if command -v lsblk >/dev/null 2>&1; then
		lsblk -dno NAME,SIZE,MODEL,TRAN 2>/dev/null \
			| grep -Ev '^(loop|sr|ram|zram)' \
			| awk '{printf "  /dev/%-8s %-9s %s %s\n", $1, $2, $3, $4}'
	else
		printf '  (lsblk indisponible)\n'
	fi
}

WARN_TITLE="Installer ${NAME} ${VER} sur le disque dur"
WARN_BODY="Tu es sur le point d'installer ${NAME} sur un disque interne.

Si tu choisis « effacer le disque » dans l'installateur, TOUT ce
qu'il contient sera définitivement perdu : fichiers, photos, autre
système d'exploitation. Il n'y a pas de retour en arrière.

Avant de continuer :
  1. Essaie ${NAME} depuis la clé USB — la session démo ne touche
     à rien sur ton disque.
  2. Sauvegarde ce qui compte sur un disque externe.
  3. Branche l'ordinateur sur le secteur.

INSTALLER À CÔTÉ DE WINDOWS ? Trois choses à faire DANS WINDOWS
d'abord, sinon le partage du disque échoue :
  a. BitLocker : Windows 11 chiffre souvent le disque tout seul.
     Suspends BitLocker (Panneau de config), ou note ta clé de
     secours sur aka.ms/myrecoverykey. Sans ça, l'option « à côté »
     peut ne pas apparaître, ou Windows réclamera une clé au retour.
  b. Démarrage rapide : désactive-le (Options d'alimentation).
     Sinon Windows « hiberne » au lieu de s'arrêter, le disque reste
     verrouillé, et il ne peut pas être redimensionné.
  c. Secure Boot : dans le BIOS (touche F2/F12 au démarrage), mets-le
     sur « Désactivé ». L'édition pro embarque le pilote NVIDIA, qui
     ne se charge PAS quand Secure Boot est actif (écran noir).

Puis, dans l'installateur : choisis « Installer à côté », JAMAIS
« effacer », et NE COCHE PAS le chiffrement.

Disques détectés sur cette machine :"

# =============================================================================
#  Mode graphique
# =============================================================================
#  ═══ LA HAUTEUR DE L'ÉCRAN, LUE ET JAMAIS SUPPOSÉE ═══
#  La fenêtre d'avertissement n'avait pas de hauteur : yad la calculait sur
#  ~40 lignes de texte, elle dépassait 1080 px, et LES BOUTONS TOMBAIENT SOUS
#  L'ÉCRAN. Constaté sur un 1920×1080, donc sur la majorité des machines.
#
#  ET UNE CONSTANTE NE CORRIGE PAS ÇA. « --height=620 » irait sur un 1080p et
#  déborderait encore sur le 1366×768 d'un netbook. On lit donc la hauteur
#  réelle et on plafonne à ce que l'écran peut montrer.
#
#  LA CASCADE FINIT SUR CE QUI EST GARANTI. xrandr et xdotool sont pratiques
#  mais ne sont dans AUCUNE liste stricte : s'appuyer sur eux, c'est reposer
#  le problème un cran plus loin. python3-gi, lui, est au socle — il ferme la
#  cascade, et 768 ferme le tout au cas où même l'écran ne répondrait pas.
ecran_hauteur() {
	local h=""
	if command -v xrandr >/dev/null 2>&1; then
		h="$(xrandr 2>/dev/null | awk '/\*/ {split($1, a, "x"); print a[2]; exit}')"
	fi
	if ! [[ "$h" =~ ^[0-9]+$ ]] && command -v xdotool >/dev/null 2>&1; then
		h="$(xdotool getdisplaygeometry 2>/dev/null | awk '{print $2}')"
	fi
	if ! [[ "$h" =~ ^[0-9]+$ ]] && command -v python3 >/dev/null 2>&1; then
		h="$(python3 -c "
import gi
gi.require_version('Gdk', '3.0')
from gi.repository import Gdk
d = Gdk.Display.get_default()
m = d.get_monitor(0) if d else None
print(m.get_geometry().height if m else 0)" 2>/dev/null)"
	fi
	[[ "$h" =~ ^[0-9]+$ ]] && (( h > 200 )) || h=768
	printf '%s' "$h"
}

#  La hauteur du dialogue : ce qu'on voudrait, borné par ce que l'écran peut
#  montrer. Les 120 px réservés sont la barre du haut, le cadre de la fenêtre
#  et une marge — de quoi garantir que la RANGÉE DE BOUTONS reste visible,
#  qui est le seul élément non négociable de cette fenêtre.
hauteur_dialogue() {
	local voulue="${1:-720}" ecran plafond
	ecran="$(ecran_hauteur)"
	plafond=$(( ecran - 120 ))
	(( plafond < 320 )) && plafond=320
	(( voulue > plafond )) && voulue=$plafond
	printf '%s' "$voulue"
}

gui_confirm() {
	local disks; disks="$(list_disks)"
	local h; h="$(hauteur_dialogue 720)"

	#  ═══ LE CORPS DÉFILE, IL N'EST PAS TRONQUÉ ═══
	#  Un avertissement coupé est PIRE qu'un avertissement long : BitLocker et
	#  Secure Boot sont justement à la fin, et ce sont eux qui coûtent un
	#  disque quand on ne les a pas lus. « --text-info » donne une zone de
	#  texte qui défile, et surtout : les boutons vivent HORS de cette zone,
	#  donc ils restent à l'écran quelle que soit la longueur du texte.
	local corps="${WARN_BODY}

${disks}"

	if command -v yad >/dev/null 2>&1; then
		#  ═══ L'ORDRE DES BOUTONS NE CHANGE PAS, ET C'EST MESURÉ ═══
		#  yad donne le focus au PREMIER bouton déclaré, pas au dernier :
		#  Entrée déclenche donc « Annuler », ce qui est le comportement voulu.
		#  Vérifié en envoyant une vraie touche Entrée aux deux ordres sur un
		#  serveur X : « Annuler puis Installer » → Annuler ; l'ordre inverse
		#  → Installer. Inverser aurait CRÉÉ le danger qu'on cherchait à
		#  écarter. Avec --text-info, le focus part même dans la zone de texte
		#  et Entrée ne déclenche plus aucun bouton du tout.
		printf '%s\n' "$corps" | yad --title="$WARN_TITLE" \
			--window-icon=lexos --image=dialog-warning --image-on-top \
			--width=640 --height="$h" --center --borders=16 \
			--text-info --wrap \
			--text="<span size='large' weight='bold'>⚠ Cette opération peut effacer ton disque dur</span>" \
			--button="Annuler — rester en démo:1" \
			--button="J'ai compris, installer:0"
		return $?
	fi

	if command -v zenity >/dev/null 2>&1; then
		#  ═══ ICI, LE DANGER ÉTAIT RÉEL — ET IL A FALLU TROIS MESURES ═══
		#  1. « zenity --question --ok-label=Installer » donne le focus à
		#     INSTALLER : Entrée lançait l'installation. Le danger signalé est
		#     donc bien réel de ce côté-ci (il ne l'était pas côté yad).
		#  2. « --default-cancel » corrige ça — mais il est SILENCIEUSEMENT
		#     IGNORÉ avec « --text-info », qui est la seule forme qui fait
		#     défiler le texte. Mesuré : Entrée installe quand même.
		#  3. Inverser les rôles des deux boutons aurait été pire : zenity rend
		#     le même code (1) pour « Annuler » ET pour la fermeture de la
		#     fenêtre. Fermer la fenêtre serait alors devenu « installer ».
		#
		#  D'OÙ LA CASE À COCHER, qui répond aux quatre exigences à la fois et
		#  vaut mieux qu'un bouton par défaut : tant qu'elle n'est pas cochée,
		#  le bouton d'installation est INSENSIBLE. Mesuré : Entrée sans avoir
		#  coché ne fait rien du tout. On ne peut plus lancer l'installation
		#  par un appui distrait — il faut un geste qui dit « j'ai lu ».
		printf '%s\n' "$corps" | zenity --text-info --width=620 --height="$h" \
			--title="$WARN_TITLE" \
			--checkbox="J'ai lu l'avertissement en entier et je comprends que mon disque peut être effacé" \
			--ok-label="J'ai compris, installer" \
			--cancel-label="Annuler — rester en démo"
		return $?
	fi
	return 2
}

# =============================================================================
#  Mode console
# =============================================================================
tty_confirm() {
	printf '\n%s%s⚠  %s%s\n\n' "$B" "$E" "$WARN_TITLE" "$R"
	printf '%s\n' "$WARN_BODY"
	list_disks
	printf '\n%sPour confirmer, tape exactement :%s EFFACER\n' "$Y" "$R"
	printf 'Sinon, appuie sur Entrée pour annuler.\n\n> '
	local answer=""
	read -r answer || true
	[[ "$answer" == "EFFACER" ]]
}

# =============================================================================
#  Déroulement
# =============================================================================
if (( ! IS_LIVE )); then
	printf '%s%s%s %s\n' "$Y" "!" "$R" \
		"Tu n'es pas en session démo : ${NAME} semble déjà installé sur ce disque."
	printf '  Relance l'\''installateur depuis la clé USB si tu veux réinstaller.\n'
	if [[ -z "${DISPLAY:-}" ]]; then
		exit 1
	fi
	command -v zenity >/dev/null 2>&1 && zenity --warning --width=460 \
		--text="Tu n'es pas en session démo.\nDémarre depuis la clé USB ${NAME} pour installer." 2>/dev/null
	exit 1
fi

printf '%s»%s Support de démarrage : %s\n' "$O" "$R" "$(boot_media)"

if (( FORCE )); then
	CONFIRMED=0
elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
	gui_confirm; RC=$?
	if (( RC == 2 )); then tty_confirm; CONFIRMED=$?; else CONFIRMED=$RC; fi
else
	tty_confirm; CONFIRMED=$?
fi

if (( CONFIRMED != 0 )); then
	printf '%s»%s Installation annulée — tu restes en session démo. Rien n'\''a été modifié.\n' \
		"$O" "$R"
	exit 0
fi

if ! command -v calamares >/dev/null 2>&1; then
	printf '%s✗%s Installateur (calamares) introuvable sur cette image.\n' "$E" "$R"
	exit 1
fi

#  Fuseau horaire : proposer le vrai (GPS puis IP), jamais l'imposer. Un
#  échec ici (détecteur absent, GPS et réseau tous deux muets) ne bloque
#  jamais l'installation — voir lexos-fuseau-confirmer.
/usr/lib/lexos/lexos-fuseau-confirmer || true

printf '%s»%s Lancement de l'\''installateur…\n' "$O" "$R"
if [[ $EUID -ne 0 ]]; then
	exec sudo -E calamares -d
fi
exec calamares -d
