#!/bin/sh
# =============================================================================
#  lexos-update-check — notifie s'il y a des mises à jour disponibles
# =============================================================================
#  Appelé par lexos-update-check.timer, une fois par jour. Les mises à jour
#  de sécurité s'installent déjà toutes seules (unattended-upgrades) ; ce
#  script prévient juste quand il en reste d'autres à appliquer à la main
#  avec « lexos upgrade ».
# =============================================================================
set -eu

#  ═══ UN PLAFOND SUR LE RÉSEAU, PARCE QU'APT N'EN A PAS ═══
#  « apt-get update » télécharge les index Debian ; sur un réseau qui répond
#  mal — un portail captif d'hôtel, une 4G partagée, un miroir en panne — il
#  peut traîner très longtemps sans jamais échouer franchement. Personne
#  n'attend le résultat de cette vérification : mieux vaut l'abandonner
#  proprement et retenter demain que de laisser un service pendu.
#
#  120 s, pas 300 : TimeoutStartSec=300 dans l'unité est une sécurité de
#  dernier recours, qui TUE le service. Celui-ci le fait renoncer, ce qui est
#  différent — le « || exit 0 » ci-dessous rend la main sans erreur.
#
#  « command -v timeout » : coreutils le fournit, mais on ne parie pas sur sa
#  présence pour une commodité. Sans lui, on fait ce qu'on faisait avant.
if command -v timeout >/dev/null 2>&1; then
	timeout 120 apt-get update -qq >/dev/null 2>&1 || exit 0
else
	apt-get update -qq >/dev/null 2>&1 || exit 0
fi

N="$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst ' || true)"
[ "${N:-0}" -gt 0 ] || exit 0

TITLE="LexOS — mises à jour disponibles"
BODY="${N} mise(s) à jour prête(s) — lexos upgrade"

for BUS in /run/user/*/bus; do
	[ -S "$BUS" ] || continue
	UID_NUM="$(basename "$(dirname "$BUS")")"
	sudo -u "#${UID_NUM}" \
		DBUS_SESSION_BUS_ADDRESS="unix:path=${BUS}" \
		notify-send -i software-update-available "$TITLE" "$BODY" 2>/dev/null || true
done
