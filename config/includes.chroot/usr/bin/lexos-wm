#!/usr/bin/env bash
# =============================================================================
#  lexos-wm — démarre le gestionnaire de fenêtres avec les effets CRT
# =============================================================================
#  xfwm4 + picom est le chemin PAR DÉFAUT. picom v12 sait animer, suit les
#  zones endommagées, et ne fabrique pas de bureau virtuel géant.
#  Compiz reste possible, mais SUR DEMANDE EXPLICITE (LEXOS_WM_COMPIZ=1) :
#  voir plus bas pourquoi, avec les mesures.
# =============================================================================
set -uo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lexos"
STATE="$CONF_DIR/crt"
LOG="$CONF_DIR/wm.log"
mkdir -p "$CONF_DIR"

log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >> "$LOG"; }

# --- Effets demandés ? -------------------------------------------------------
WANT="on"
[[ -r /etc/lexos/build.conf ]] && WANT="$(
	# shellcheck disable=SC1091
	. /etc/lexos/build.conf 2>/dev/null; printf '%s' "${LEXOS_CRT_EFFECTS:-on}"
)"
[[ -r "$STATE" ]] && WANT="$(cat "$STATE")"

if [[ "$WANT" != "on" ]]; then
	log "effets CRT désactivés — xfwm4"
	exec xfwm4 --replace
fi

# =============================================================================
#  CHEMIN PAR DÉFAUT : xfwm4 + picom
# =============================================================================
#  ═══ POURQUOI COMPIZ N'EST PLUS LE DÉFAUT — MESURÉ, PAS SUPPOSÉ ═══
#  Diagnostic du 2026-09-09, ThinkPad T460 d'Alex :
#
#      $ pgrep -a compiz
#      2276 compiz --replace ccp
#      $ xprop -root _NET_DESKTOP_GEOMETRY
#      _NET_DESKTOP_GEOMETRY(CARDINAL) = 7680, 1080     ← 4× l'écran (1920)
#
#  Compiz 0.8.18 (la branche héritée, celle que Debian livre encore) activait
#  le greffon « wall », qui fabrique un bureau virtuel quatre fois plus large
#  que l'écran. Cette branche n'a AUCUN suivi des zones endommagées : elle
#  repeint la surface entière à chaque image, sur un GPU intégré qui partage
#  la mémoire système. C'est la cause nº1 des saccades.
#
#  ═══ ET LE BON CHEMIN ÉTAIT INATTEIGNABLE ═══
#  Le bloc Compiz plus bas fait « wait "$CPID" », qui ne rend la main que si
#  Compiz MEURT. Tant qu'il vivait, tout le code en dessous était mort :
#  le démarrage de picom ET le « exec xfwm4 --replace » final. La version
#  fluide était écrite depuis des semaines et n'a jamais pu s'exécuter.
#  Le commentaire qui expliquait ce repli affirmait « Compiz a été RETIRÉ de
#  Debian trixie, donc has_3d() échoue toujours » : c'est faux sur l'image
#  livrée, et c'est précisément ce qui a masqué le bogue.
#
#  ═══ CE QU'ON GAGNE EN PLUS ═══
#  Le chemin Compiz coûtait, à CHAQUE ouverture de session, cinq secondes de
#  « sleep » puis un « xfce4-panel --restart » complet — le « menu qui
#  apparaît et disparaît » qu'Alex décrivait. Relevé dans son wm.log :
#      [10:58:35] démarrage de Compiz (effets CRT)
#      [10:58:40] Compiz en place — on relance la barre du haut
#  Ce chemin-ci n'a ni l'un ni l'autre.
#
#  lexos-crt vérifie lui-même ses conditions (effets demandés, version de
#  picom, accélération 3D réelle) et sort sans rien faire s'il en manque
#  une : on peut donc l'appeler sans garde ici. Et il est lancé DÉTACHÉ,
#  parce que « exec » plus bas remplace ce processus.
if [[ "${LEXOS_WM_COMPIZ:-0}" != "1" ]]; then
	log "compositeur : xfwm4 + picom"
	if command -v lexos-crt >/dev/null 2>&1; then
		setsid lexos-crt --demarrer >/dev/null 2>&1 &
	fi
	exec xfwm4 --replace
fi

# =============================================================================
#  CHEMIN COMPIZ — sur demande explicite seulement (LEXOS_WM_COMPIZ=1)
# =============================================================================
#  Gardé pour le débogage et pour qui veut comparer. Compiz n'est plus livré
#  dans l'ISO : ce chemin ne sert qu'à celui qui l'a installé lui-même.

# --- L'accélération 3D est-elle réelle ? ------------------------------------
has_3d() {
	command -v compiz >/dev/null 2>&1 || { log "compiz absent"; return 1; }
	command -v glxinfo >/dev/null 2>&1 || { log "glxinfo absent"; return 1; }

	local info
	info="$(timeout 10 glxinfo 2>/dev/null)" || { log "glxinfo a échoué"; return 1; }

	grep -q 'direct rendering: Yes' <<< "$info" || { log "pas de rendu direct"; return 1; }

	# llvmpipe / softpipe / swrast = rendu logiciel : Compiz ramerait.
	if grep -Ei 'OpenGL renderer string.*(llvmpipe|softpipe|swrast)' <<< "$info" >/dev/null; then
		log "rendu logiciel détecté — repli xfwm4"
		return 1
	fi
	return 0
}

if has_3d; then
	log "démarrage de Compiz (effets CRT)"
	# Si Compiz meurt dans les 5 s, on rattrape avec xfwm4.
	compiz --replace ccp >>"$LOG" 2>&1 &
	CPID=$!
	sleep 5

	#  REMETTRE LA BARRE DU HAUT APRÈS LE REMPLACEMENT.
	#  « --replace » change de gestionnaire de fenêtres SOUS une barre déjà
	#  affichée : elle perd son ancrage et disparaît. C'est ce qu'Alex a vu
	#  sur le portable — « le menu apparaît et disparaît pas longtemps après ».
	#  On ne peut pas démarrer Compiz avant la barre : la détection 3D passe
	#  par glxinfo, qui prend plusieurs secondes, et pendant ce temps la
	#  session a déjà lancé le panneau. On répare donc APRÈS, une fois Compiz
	#  en place — c'est laid, mais c'est honnête et ça rend la barre.
	#  (Ce chemin ne sert que si les effets sont RÉACTIVÉS à la main : le
	#  défaut est désormais « off », justement pour ne pas en arriver là.)
	if kill -0 "$CPID" 2>/dev/null && command -v xfce4-panel >/dev/null 2>&1; then
		log "Compiz en place — on relance la barre du haut"
		xfce4-panel --restart >>"$LOG" 2>&1 \
			|| { xfce4-panel --quit >/dev/null 2>&1; sleep 1; setsid xfce4-panel >>"$LOG" 2>&1 & }
	fi
	if kill -0 "$CPID" 2>/dev/null; then
		wait "$CPID"
		log "Compiz s'est arrêté — reprise par xfwm4"
	else
		log "Compiz a échoué au démarrage — repli xfwm4"
	fi
else
	log "accélération 3D indisponible — xfwm4"
fi

#  ═══ LES EFFETS « TÉLÉVISEUR », SANS COMPIZ ═══
#  ALEX : « l'effet d'animation n'est pas là quand je ferme des fenêtres ».
#
#  CE COMMENTAIRE A DÉJÀ MENTI UNE FOIS, ET ÇA A COÛTÉ DES SEMAINES.
#  Il affirmait « Compiz a été RETIRÉ de Debian trixie, donc has_3d()
#  échoue toujours et on se replie ici ». C'était faux sur l'image livrée :
#  Compiz s'installait, has_3d() réussissait, le « wait » du bloc ci-dessus
#  ne rendait jamais la main, et ces lignes-ci n'étaient JAMAIS atteintes.
#  Une prémisse fausse dans un commentaire est plus dangereuse qu'un
#  commentaire absent : elle décourage de vérifier.
#  Aujourd'hui ce repli sert quand Compiz, demandé à la main, s'arrête.
#
#  lexos-crt reprend ce travail avec picom, qui sait animer depuis sa v12.
#  Il vérifie lui-même tout ce qu'il faut (effets demandés, picom présent et
#  assez récent, accélération 3D réelle, aucun Compiz en marche) et ne fait
#  rien si une condition manque : on peut donc l'appeler sans condition ici.
#
#  EN ARRIÈRE-PLAN ET DÉTACHÉ, parce que la ligne suivante REMPLACE ce
#  processus par xfwm4 : un enfant non détaché n'y survivrait pas. Et c'est
#  lui qui attend que le remplacement soit fini avant de lancer picom.
if command -v lexos-crt >/dev/null 2>&1; then
	setsid lexos-crt --demarrer >/dev/null 2>&1 &
fi

exec xfwm4 --replace
