#!/usr/bin/env bash
# =============================================================================
#  lexos-format — formate une clé USB ou un téléphone (stockage de masse),
#  APRÈS confirmation explicite. Jamais le disque système.
# =============================================================================
#  Règle de la maison : comme pour l'installation sur disque, on n'efface
#  jamais rien sans un avertissement clair et une confirmation explicite.
#  Ce script refuse tout support qui n'est pas amovible, et refuse en
#  particulier le disque qui héberge /, /home, /boot, /usr ou /var.
# =============================================================================
set -uo pipefail

# =============================================================================
#  LES OUTILS DE DISQUE NE SONT PAS DANS LE PATH D'UN PROGRAMME DU BUREAU
# =============================================================================
#  ALEX : « pas capable de faire formater ma clé USB, il affiche outil
#  manquant ». Le message vient d'ici — de need() plus bas — et il était
#  TROMPEUR : l'outil n'était pas absent de la machine, il était absent du
#  PATH.
#
#  Le clic droit « Formater ce support… » lance « lexos-format --gui » depuis
#  Thunar, donc sous le compte ordinaire. Or Debian ne met les répertoires
#  sbin dans le PATH que pour root (/etc/profile fait le test sur l'UID) :
#  un utilisateur normal reçoit /usr/local/bin:/usr/bin:/bin et rien d'autre.
#  Et parted, mkfs.vfat, mkfs.ext4, mkfs.exfat et wipefs vivent tous dans
#  /usr/sbin. « command -v parted » répondait donc NON sur une machine où
#  parted est parfaitement installé.
#
#  On ajoute donc les sbin à notre propre PATH — EN QUEUE, jamais en tête.
#  Mis devant, ils passeraient AVANT ce que l'utilisateur, ou un banc
#  d'essai, a déjà mis dans le sien : deux bancs de ce dépôt injectent de
#  faux outils par un répertoire en tête de PATH, et les doubler par les
#  vrais les a rendus aveugles sur-le-champ. Ils ont rougi tout de suite,
#  et c'est comme ça que la première version de ce correctif a été prise en
#  faute.
#  C'est sans risque là où ces répertoires n'existent pas ou ne sont que des
#  liens vers /usr/bin : un chemin absent du disque ne coûte rien dans un
#  PATH.
#  SEAM DE BANC. Un banc qui simule un outil ABSENT le fait en
#  restreignant le PATH ; lui rajouter les sbin le rendrait aveugle et
#  ferait passer pour presente une commande que la machine reelle
#  n'aurait pas. LEXOS_SANS_SBIN=1 desactive l'ajout.
[ "${LEXOS_SANS_SBIN:-}" = "1" ] || PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"
export PATH

PROG="${0##*/}"
GUI=0
SANS_ECRAN=0
TARGET=""
FSTYPE=""
JSON=0
CONFIRME=0

for a in "$@"; do
	case "$a" in
		--gui) GUI=1 ;;
		--fs=*) FSTYPE="${a#--fs=}" ;;
		#  « --json » : dis-moi ce que tu ACCEPTERAIS de formater, et tais-toi.
		#  C'est la page « Formatage » des Paramètres qui le demande. Le mode
		#  ne touche à rien : il lit et il sort.
		--json) JSON=1 ;;
		#  « --confirme » : la confirmation a déjà été donnée ailleurs (la
		#  page l'a fait recopier le nom du support). Il REMPLACE la question
		#  finale, il ne remplace AUCUNE vérification : toutes celles du
		#  paragraphe « Choix de la cible » tournent avant, dans le même
		#  ordre, et la moindre les fait sortir. Voir le commentaire au-dessus
		#  de la confirmation.
		--confirme|--oui) CONFIRME=1 ;;
		#  « --texte » : n'essaie RIEN d'afficher. C'est la passe privilégiée
		#  qui le reçoit, parce que pkexec lui a retiré DISPLAY et
		#  XAUTHORITY (mesuré, voir elever_pour_formater). Une boîte de
		#  dialogue lancée là ne s'ouvrirait pas — elle échouerait en
		#  silence, ce qui est exactement le défaut qu'on corrige.
		--texte) GUI=0; SANS_ECRAN=1 ;;
		-*) ;;
		*) [[ -z "$TARGET" ]] && TARGET="$a" ;;
	esac
done

#  « --texte » l'emporte, quel que soit l'ordre où les options arrivent :
#  c'est une contrainte de la machine (il n'y a pas d'écran), pas une
#  préférence que « --gui » pourrait renverser.
[[ "$SANS_ECRAN" -eq 1 ]] && GUI=0

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; E=$'\033[31m'; Y=$'\033[33m'; G=$'\033[32m'; B=$'\033[1m'; R=$'\033[0m'
else
	O=''; E=''; Y=''; G=''; B=''; R=''
fi
say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$R" "$*"; }
err()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; }
#  420 px suffisaient avec une police d'interface. Avec une écriture à la
#  main — douze au choix dans les Paramètres — le même message se replie sur
#  quatre ou cinq lignes dans une boîte étroite. 560 px le tiennent sur deux.
#  Rien n'est CACHÉ ici (zenity replie le texte, il ne le coupe pas) : c'est
#  du confort, contrairement aux listes plus bas.
die()  { err "$*"; [[ "$GUI" -eq 1 ]] && command -v zenity >/dev/null 2>&1 && \
         zenity --error --width=560 --title="LexOS" --text="$*" 2>/dev/null; exit 1; }

cmd_help() {
	cat <<EOF

${B}${O}${PROG}${R} — formater une clé USB ou un téléphone

${B}USAGE${R}
  ${PROG} [cible]           Cible : /media/lex/CLÉ, /dev/sdb1, /dev/sdb…
  ${PROG}                   Sans cible : choisis parmi les supports détectés

${B}À SAVOIR${R}
  Uniquement les supports amovibles — jamais le disque système. Tout le
  contenu du support est perdu ; confirmation explicite exigée.

EOF
}
[[ "${TARGET:-}" == "help" || "${TARGET:-}" == "--help" || "${TARGET:-}" == "-h" ]] && { cmd_help; exit 0; }

#  UN OUTIL VRAIMENT ABSENT DOIT DIRE QUOI INSTALLER. « Outil manquant :
#  parted » n'apprend rien à qui ne sait pas que parted vient du paquet
#  parted — et surtout rien à qui ne sait pas qu'on peut l'installer. Même
#  règle que partout ailleurs dans LexOS : on nomme la condition qui manque.
paquet_de() { # paquet_de <commande> -> le paquet Debian qui la fournit
	case "$1" in
		parted)     printf 'parted' ;;
		mkfs.vfat)  printf 'dosfstools' ;;
		mkfs.ext4)  printf 'e2fsprogs' ;;
		mkfs.exfat) printf 'exfatprogs' ;;
		wipefs|lsblk|findmnt) printf 'util-linux' ;;
		*)          printf '%s' "$1" ;;
	esac
}
need() {
	command -v "$1" >/dev/null 2>&1 && return 0
	die "Outil manquant : $1 — installe-le avec :  lexos install $(paquet_de "$1")"
}
need lsblk
need findmnt

#  L'échappement JSON vit dans un fichier commun — deux copies de trois
#  lignes finissent toujours par diverger. Le chemin est calculé depuis ce
#  script-ci pour que les bancs puissent le faire tourner depuis le dépôt,
#  sans rien installer.
_lib_json="$(dirname "$(readlink -f "$0")")/../share/lexos/shell/json.sh"
[[ -r $_lib_json ]] || _lib_json=/usr/share/lexos/shell/json.sh
if [[ -r $_lib_json ]]; then
	# shellcheck source=/dev/null
	. "$_lib_json"
else
	json_texte() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
fi

# =============================================================================
#  Détection des supports amovibles (jamais le disque système)
# =============================================================================
#  ═══ « PAS DE PARENT » VEUT DIRE « C'EST DÉJÀ LE DISQUE » ═══
#  Ces deux fonctions repliaient sur « basename | sed -E 's/p?[0-9]+$//' »
#  quand lsblk ne rendait pas de parent. Or lsblk ne rend PAS de parent
#  précisément quand on lui donne un disque ENTIER — et le repli rognait
#  alors son nom :
#      mmcblk0 -> mmcblk     (la carte SD d'un appareil photo, d'un téléphone)
#      loop0   -> loo
#  Le programme cherchait ensuite /dev/mmcblk et répondait « Support
#  introuvable » sur une carte parfaitement présente. Choisir une carte SD
#  dans la liste ne pouvait pas marcher.
#  lsblk est exigé plus haut par need(), donc son absence n'est pas un cas :
#  un parent vide signifie « disque entier », et on garde le nom tel quel.
nom_de_disque() {   # <chemin /dev/xxx> -> nom du DISQUE qui le porte
	local dev="$1" parent
	parent="$(lsblk -no PKNAME "$dev" 2>/dev/null | grep -v '^$' | head -1)"
	if [[ -n "$parent" ]]; then
		printf '%s' "$parent"
	else
		basename "$dev"
	fi
}

root_disk() {
	local src
	src="$(findmnt -no SOURCE / 2>/dev/null)"
	[[ -n "$src" ]] || { printf ''; return; }
	nom_de_disque "$src"
}
ROOT_DISK="$(root_disk)"

#  ═══ UN SEUL JUGE, UNE SEULE LISTE ═══
#  Ce qu'un disque doit être pour apparaître ici est exactement ce qu'il doit
#  être pour être formaté : amovible, pas le disque système, et n'hébergeant
#  aucun point de montage vital. La page des Paramètres ne redécide RIEN —
#  elle affiche ce que cette fonction rend. Deux juges qui finiraient par ne
#  plus dire la même chose, c'est un disque qui y passe.
heberge_critique() {   # <nom de disque sans /dev/> -> 0 s'il héberge du vital
	local mp src src_disk
	for mp in / /home /boot /usr /var; do
		src="$(findmnt -no SOURCE "$mp" 2>/dev/null)" || continue
		[[ -n "$src" ]] || continue
		src_disk="$(nom_de_disque "$src")"
		[[ "$src_disk" == "$1" ]] && return 0
	done
	return 1
}

disques_eligibles() {   # un nom de disque par ligne, rien d'autre
	local n
	while read -r n; do
		[[ -n "$n" ]] || continue
		[[ "$n" == "$ROOT_DISK" ]] && continue
		heberge_critique "$n" && continue
		printf '%s\n' "$n"
	done < <(lsblk -dno NAME,RM 2>/dev/null | awk '$2=="1" {print $1}')
}

list_removable() {
	local n
	while read -r n; do
		[[ -n "$n" ]] || continue
		lsblk -dno NAME,SIZE,MODEL "/dev/$n" 2>/dev/null \
			| awk '{printf "%-10s %-9s %s\n",$1,$2,$3}'
	done < <(disques_eligibles)
}

#  Le même inventaire, pour la page. Les valeurs viennent du système (modèle
#  du fabricant, étiquette choisie par quelqu'un) : elles passent par
#  json_texte, sans quoi une apostrophe dans « Kingston DataTraveler 3.0 »
#  laisserait la page blanche, sans message.
liste_json() {
	local n taille modele etiq montages premier=1
	printf '{"supports":['
	while read -r n; do
		[[ -n "$n" ]] || continue
		taille="$(lsblk -dno SIZE "/dev/$n" 2>/dev/null | tr -d ' ')"
		modele="$(lsblk -dno MODEL "/dev/$n" 2>/dev/null | sed -E 's/[[:space:]]+$//')"
		#  L'étiquette et les montages vivent sur les PARTITIONS, pas sur le
		#  disque : on les rassemble, séparés par une virgule.
		etiq="$(lsblk -no LABEL "/dev/$n" 2>/dev/null | grep -v '^$' | paste -sd ', ' -)"
		montages="$(lsblk -no MOUNTPOINT "/dev/$n" 2>/dev/null | grep -v '^$' | paste -sd ', ' -)"
		[[ "$premier" -eq 1 ]] || printf ','
		premier=0
		printf '{"nom":"%s","chemin":"%s","taille":"%s","modele":"%s","etiquette":"%s","montages":"%s"}' \
			"$(json_texte "$n")" "$(json_texte "/dev/$n")" \
			"$(json_texte "$taille")" "$(json_texte "$modele")" \
			"$(json_texte "$etiq")" "$(json_texte "$montages")"
	done < <(disques_eligibles)
	printf '],"systemes":['
	printf '{"cle":"vfat","titre":"FAT32","texte":"partout, même les téléphones (4 Go max par fichier)"},'
	printf '{"cle":"exfat","titre":"exFAT","texte":"partout aussi, sans limite de taille"},'
	printf '{"cle":"ext4","titre":"ext4","texte":"Linux seulement, sans limite"}'
	printf ']}\n'
}

resolve_disk() { # <chemin ou /dev/x> -> nom de disque (sans /dev/)
	local target="$1" dev disk
	if [[ -b "$target" ]]; then
		dev="$target"
	else
		dev="$(findmnt -no SOURCE --target "$target" 2>/dev/null)"
	fi
	[[ -n "$dev" && -b "$dev" ]] || return 1
	disk="$(nom_de_disque "$dev")"
	printf '%s' "$disk"
}

is_removable() {
	local rm; rm="$(lsblk -dno RM "/dev/$1" 2>/dev/null)"
	[[ "$rm" == "1" ]]
}

# --- « --json » : on lit, on écrit, on sort ---------------------------------
#  AVANT tout choix de cible et avant toute élévation de droits : ce mode ne
#  touche à rien et n'a besoin d'aucun droit particulier. La page des
#  Paramètres tourne sous le compte ordinaire.
if [[ "$JSON" -eq 1 ]]; then
	liste_json
	exit 0
fi

# --- Choix de la cible -------------------------------------------------------
if [[ -z "$TARGET" ]]; then
	CANDIDATES="$(list_removable)"
	[[ -n "$CANDIDATES" ]] || die "Aucun support amovible détecté. Branche une clé USB ou un téléphone (en mode stockage de masse), puis réessaie."

	if [[ "$GUI" -eq 1 ]] && command -v zenity >/dev/null 2>&1; then
		LIST_ARGS=()
		while IFS= read -r line; do
			LIST_ARGS+=("/dev/$(awk '{print $1}' <<< "$line")" "$line")
		done <<< "$CANDIDATES"
		#  ═══ 920x480, MESURÉ — ET LE NOMBRE DE LIGNES N'EST PAS CONNU ═══
		#  Cette liste-ci est la plus exposée des cinq : le nombre de rangées
		#  dépend de ce qui est branché. Une hauteur fixe de 280 px coupait
		#  le troisième disque exactement comme elle cachait « ext4 » plus
		#  bas.
		#  Et la largeur était pire encore : à 520, la colonne « Détails »
		#  était coupée POUR TOUTES LES POLICES, la police par défaut
		#  comprise — la ligne d'un disque (nom, taille, modèle, partitions,
		#  point de montage) demande 777 px avec elle, et 854 px avec
		#  « Ronde », la plus large des douze écritures d'Alex.
		#  À 920x480, cinq disques tiennent avec la plus haute des douze
		#  (« Tableau noir », 33 px par rangée) et il reste de la place.
		#  MESURÉ, PAS DEVINÉ — banc test_lexos_format_boites.sh.
		DISK_PATH="$(zenity --list --title="Formater — choisir le support" \
			--column="Support" --column="Détails" "${LIST_ARGS[@]}" \
			--width=920 --height=480 2>/dev/null)"
		[[ -n "$DISK_PATH" ]] || exit 0
		DISK="$(basename "$DISK_PATH")"
	else
		printf '\n%sSupports amovibles détectés :%s\n\n' "$B$O" "$R"
		printf '%s\n' "$CANDIDATES"
		printf '\n%sNom du disque à formater (ex. : sdb) : %s' "$Y" "$R"
		read -r DISK || exit 1
		[[ -n "$DISK" ]] || exit 1
	fi
else
	DISK="$(resolve_disk "$TARGET")" \
		|| die "Impossible de trouver le support pour : ${TARGET}"
fi
DISK="${DISK#/dev/}"

[[ -b "/dev/$DISK" ]] || die "Support introuvable : /dev/${DISK}"
[[ "$DISK" != "$ROOT_DISK" ]] \
	|| die "Impossible de formater /dev/${DISK} : c'est le disque système. Refusé."
is_removable "$DISK" \
	|| die "/dev/${DISK} n'est pas un support amovible. Par sécurité, seuls les supports amovibles peuvent être formatés ici."

# --- Aucune partition de ce disque ne doit être un point de montage critique -
#  LA MÊME FONCTION QUE LA LISTE. Elle était écrite deux fois : ici en clair,
#  et nulle part pour la liste — qui ne faisait donc PAS ce test. Un disque
#  amovible hébergeant /home serait apparu dans la liste et refusé au dernier
#  moment. Maintenant les deux passent par heberge_critique().
if heberge_critique "$DISK"; then
	die "/dev/${DISK} héberge un dossier vital du système (/, /home, /boot, /usr ou /var) — refusé par sécurité."
fi

INFO="$(lsblk -no NAME,SIZE,LABEL,MOUNTPOINT "/dev/$DISK" 2>/dev/null)"

# =============================================================================
#  Système de fichiers
# =============================================================================
if [[ -z "$FSTYPE" ]]; then
	if [[ "$GUI" -eq 1 ]] && command -v zenity >/dev/null 2>&1; then
		#  ═══ 800x440, ET LE CHIFFRE EST MESURÉ ═══
		#  ALEX : « la page de formatage, on pourrait-tu la mettre un peu
		#  plus gros pour bien voir tout le menu ? » Il voyait les
		#  descriptions coupées. Le vrai défaut était pire : à 560x260, la
		#  liste n'avait la place que de DEUX rangées — « ext4 » était
		#  proposé par le code et INVISIBLE à l'écran. Une fonction offerte
		#  et inatteignable, pas un défaut de confort.
		#
		#  POURQUOI 560x260 A FINI PAR NE PLUS SUFFIRE. LexOS livre douze
		#  écritures à la main, et Alex en change quand il veut. Une taille
		#  en pixels tient avec l'une et déborde avec l'autre. Relevé au
		#  Pango de GTK, sur les douze plus les trois polices d'interface :
		#      la plus large ....... « Ronde » (Short Stack 11) : la colonne
		#                            Description demande 506 px à elle seule
		#      la plus haute ....... « Tableau noir » (Gloria Hallelujah 10)
		#                            33 px par rangée, contre 24 par défaut
		#  À 800x440, la liste reçoit 790x354 au pire et n'en demande que
		#  720x127 : 70 px de marge en largeur, et la place de trois rangées
		#  de plus en hauteur. Vérifié pour LES QUINZE polices, et rendu
		#  pour de vrai avec zenity — les trois lignes sont là, entières.
		#  MESURÉ, PAS DEVINÉ. Le banc test_lexos_format_boites.sh refait
		#  la mesure à chaque construction.
		#
		#  Les descriptions sont raccourcies au passage : gagner de la
		#  largeur par le texte tient sur un portable de 1366 px, en
		#  demander à l'écran, non.
		FSTYPE="$(zenity --list --title="Formater /dev/${DISK}" --radiolist \
			--column="" --column="Système de fichiers" --column="Description" \
			TRUE  vfat  "FAT32 — partout, même les téléphones (4 Go max par fichier)" \
			FALSE exfat "exFAT — partout aussi, sans limite de taille" \
			FALSE ext4  "ext4 — Linux seulement, sans limite" \
			--width=800 --height=440 2>/dev/null)"
		[[ -n "$FSTYPE" ]] || exit 0
	else
		printf '\n%sSystème de fichiers%s ${D}(vfat = FAT32, exfat, ext4)%s — défaut : vfat\n> ' "$B$O" "$R" "$R"
		read -r FSTYPE || exit 1
		[[ -z "$FSTYPE" ]] && FSTYPE="vfat"
	fi
fi
case "${FSTYPE,,}" in
	vfat|fat32) FSTYPE="vfat" ;;
	exfat)      FSTYPE="exfat" ;;
	ext4)       FSTYPE="ext4" ;;
	*) die "Système de fichiers inconnu : ${FSTYPE} (vfat, exfat ou ext4)" ;;
esac
case "$FSTYPE" in
	vfat)  need mkfs.vfat ;;
	exfat) command -v mkfs.exfat >/dev/null 2>&1 || die "mkfs.exfat introuvable — installe exfatprogs : lexos install exfatprogs" ;;
	ext4)  need mkfs.ext4 ;;
esac
need parted

# =============================================================================
#  Confirmation
# =============================================================================
WARN="⚠ Tout le contenu de /dev/${DISK} sera définitivement effacé.

${INFO}

Système de fichiers choisi : ${FSTYPE}

Cette opération est irréversible."

#  ═══ « --confirme » REMPLACE LA QUESTION, PAS LES VÉRIFICATIONS ═══
#  C'est la pièce dangereuse du lot, alors voici exactement ce qu'elle peut
#  et ce qu'elle ne peut pas.
#
#  TOUT CE QUI PRÉCÈDE A DÉJÀ TOURNÉ, dans l'ordre, et chaque point sort du
#  programme s'il n'est pas satisfait :
#    · /dev/$DISK existe et est un périphérique bloc ;
#    · ce n'est pas le disque système ;
#    · il est AMOVIBLE (is_removable) ;
#    · il n'héberge ni /, ni /home, ni /boot, ni /usr, ni /var
#      (heberge_critique, la même fonction que la liste) ;
#    · le système de fichiers demandé est l'un des trois connus ;
#    · les outils nécessaires sont là.
#  Ce drapeau est lu ICI et NULLE PART AILLEURS : il ne peut pas court-
#  circuiter une vérification, parce qu'il arrive après toutes.
#
#  CE QU'IL SERT : la page « Formatage » des Paramètres a déjà fait recopier
#  le nom du support à la main. Reposer la question derrière est du bruit —
#  et un bruit dangereux, parce qu'une question qu'on voit deux fois est une
#  question qu'on cesse de lire.
if [[ "$CONFIRME" -eq 1 ]]; then
	say "Confirmation déjà donnée (--confirme) — on continue."
elif [[ "$GUI" -eq 1 ]] && command -v zenity >/dev/null 2>&1; then
	#  720 px : cette boîte affiche la sortie de « lsblk » telle quelle —
	#  nom, taille, étiquette, point de montage sur une ligne. À 520 px ces
	#  lignes se repliaient au milieu d'un chemin, et la question la plus
	#  irréversible de LexOS devenait la moins lisible. Mesuré avec « Ronde »
	#  (Short Stack 11), la plus large des douze écritures.
	zenity --question --width=720 --title="Formater /dev/${DISK} ?" \
		--text="$WARN" --ok-label="Tout effacer et formater" --cancel-label="Annuler" 2>/dev/null \
		|| { say "Annulé — rien n'a été modifié."; exit 0; }
else
	printf '\n%s%s%s\n\n' "$B$E" "$WARN" "$R"
	printf '%sPour confirmer, tape exactement :%s FORMATER\n' "$Y" "$R"
	printf 'Sinon, appuie sur Entrée pour annuler.\n\n> '
	ANSWER=""
	read -r ANSWER || true
	[[ "$ANSWER" == "FORMATER" ]] || { say "Annulé — rien n'a été modifié."; exit 0; }
fi

# =============================================================================
#  Formatage
# =============================================================================
say "Démontage de /dev/${DISK}…"
if command -v udisksctl >/dev/null 2>&1; then
	for PART in /dev/"${DISK}"?*; do
		[[ -b "$PART" ]] || continue
		udisksctl unmount -b "$PART" >/dev/null 2>&1 || true
	done
else
	umount "/dev/${DISK}"?* 2>/dev/null || true
fi

#  ═══ ON N'ÉLÈVE QUE LE FORMATAGE, PAS L'INTERFACE — MESURÉ ═══
#  ALEX : « que toutes les commandes pour un formatage soient bien activées
#  une fois qu'on a écrit le mot de passe. »
#
#  CE QUE ÇA FAISAIT AVANT : « exec pkexec "$0" … --gui ». Le processus se
#  REMPLAÇAIT par une version root qui gardait le mode graphique. Or pkexec
#  repart d'un environnement minimal. Mesuré sur cette machine, polkit 124 :
#
#      $ DISPLAY=:99 XAUTHORITY=/tmp/x pkexec env
#      HOME  LANG  LOGNAME  PATH  PKEXEC_UID  SHELL  TERM  USER
#
#  Huit variables, et NI DISPLAY NI XAUTHORITY. (« sudo -E », lui, les garde
#  toutes deux — vérifié côte à côte.) Après le mot de passe, plus rien ne
#  peut s'afficher : zenity n'a pas d'écran où dessiner.
#
#  Le piège est que c'est justement l'AFFICHAGE qui est cassé : die() appelle
#  zenity, donc même le message d'erreur disparaît. Alex tape son mot de
#  passe, et il ne se passe rien — sans la moindre explication. C'est aussi
#  vrai de notify-send, qui a besoin en plus du bus de session.
#
#  LE CORRECTIF N'EST PAS DE COUPER « --gui » APRÈS COUP. C'est de ne pas
#  élever l'interface du tout : on lance le travail privilégié comme un
#  ENFANT en mode TEXTE, et le parent — qui a gardé son écran — reste vivant
#  pour dire ce qui s'est passé. C'est la seule forme où un échec survenu
#  après le mot de passe peut encore être MONTRÉ.
elever_pour_formater() {
	[[ $EUID -eq 0 ]] && return 0

	#  « --confirme » repart avec l'enfant : sans lui, la version root
	#  reposerait la question — elle lirait une entrée standard que personne
	#  ne tient, et resterait plantée là. « --texte » lui interdit d'essayer
	#  d'afficher quoi que ce soit : il n'a plus d'écran, et il n'en a plus
	#  besoin, puisque c'est nous qui parlons à l'utilisateur.
	local -a SUITE=("/dev/${DISK}" "--fs=${FSTYPE}" --confirme --texte)

	local -a ELEV=()
	if command -v pkexec >/dev/null 2>&1; then
		ELEV=(pkexec)
	elif command -v sudo >/dev/null 2>&1; then
		ELEV=(sudo -E)
	else
		die "Droits administrateur requis pour formater /dev/${DISK}, et ni pkexec ni sudo ne sont installés."
	fi

	local JOURNAL CODE RAISON
	JOURNAL="$(mktemp)"
	#  La sortie d'erreur va dans un fichier, PAS dans un « tee » en
	#  substitution de processus : celui-ci peut n'avoir pas fini d'écrire
	#  quand on relit le fichier, et on perdrait justement la phrase qui
	#  explique l'échec. On la relaie nous-mêmes, une fois l'enfant terminé.
	"${ELEV[@]}" "$0" "${SUITE[@]}" 2>"$JOURNAL"
	CODE=$?
	[[ -s "$JOURNAL" ]] && cat "$JOURNAL" >&2
	RAISON="$(grep -v '^[[:space:]]*$' "$JOURNAL" 2>/dev/null | tail -2 | tr '\n' ' ')"
	rm -f "$JOURNAL"

	case "$CODE" in
		0) ;;
		#  126 et 127 sont les codes de pkexec eux-mêmes, pas ceux du
		#  formatage : les confondre ferait dire « le formatage a échoué »
		#  alors que rien n'a été touché.
		126) die "Mot de passe refusé, ou demande annulée — rien n'a été modifié sur /dev/${DISK}." ;;
		127) die "Ce compte n'est pas autorisé à formater un support. Rien n'a été modifié." ;;
		*)   die "Le formatage de /dev/${DISK} n'a pas abouti.${RAISON:+ }${RAISON}" ;;
	esac

	#  L'enfant a fini, et c'est NOUS qui avons encore un écran.
	if [[ "$GUI" -eq 1 ]] && command -v notify-send >/dev/null 2>&1; then
		notify-send -i media-removable "LexOS" "/dev/${DISK} formaté (${FSTYPE})" 2>/dev/null
	fi
	ok "/dev/${DISK} formaté en ${FSTYPE} — prêt à l'emploi."
	exit 0
}
elever_pour_formater

say "Effacement de la table de partitions…"
wipefs -a "/dev/${DISK}" >/dev/null 2>&1 || true

say "Nouvelle table de partitions…"
parted -s "/dev/${DISK}" mklabel gpt mkpart primary 0% 100% \
	|| die "Échec du partitionnement de /dev/${DISK}"
udevadm settle 2>/dev/null || true
sleep 1

NEWPART="/dev/${DISK}1"
[[ -b "$NEWPART" ]] || NEWPART="/dev/${DISK}p1"
[[ -b "$NEWPART" ]] || die "Partition introuvable après le partitionnement."

say "Formatage en ${FSTYPE}…"
case "$FSTYPE" in
	vfat)  mkfs.vfat -F32 -n LEXOS "$NEWPART" ;;
	exfat) mkfs.exfat -n LEXOS "$NEWPART" ;;
	ext4)  mkfs.ext4 -F -L LEXOS "$NEWPART" ;;
esac || die "Échec du formatage de ${NEWPART}."

udevadm settle 2>/dev/null || true
#  La passe privilégiée n'a NI écran NI bus de session : notify-send y
#  échouerait sans rien dire. C'est le parent, resté vivant, qui annonce —
#  voir elever_pour_formater. Quand on est root ET graphique (« sudo -E
#  lexos-format --gui »), il n'y a pas de parent : on annonce ici.
if [[ "$GUI" -eq 1 ]] && command -v notify-send >/dev/null 2>&1; then
	notify-send -i media-removable "LexOS" "/dev/${DISK} formaté (${FSTYPE})" 2>/dev/null
fi
ok "/dev/${DISK} formaté en ${FSTYPE} — prêt à l'emploi."
