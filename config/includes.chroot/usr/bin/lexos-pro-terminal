#!/usr/bin/env bash
# =============================================================================
#  lexos-pro-terminal — LexOS Pro Terminal, le terminal officiel
# =============================================================================
#  ALEX : « c'est le new terminal officiel de LexOS Pro, pour le terminal
#  normal je veux que ce soit lui qui le remplace. »
#
#  Même patron que lexos-settings et lexos-cartes : une fenêtre Qt (PySide6)
#  affiche une page web servie en local ; le pont terminal-pro.py exécute de
#  VRAIES commandes bash, avec les droits de la personne qui les tape.
#
#  ── CE QUI RESTE, ET POURQUOI ────────────────────────────────────────────
#  Cette fenêtre n'a pas de curseur qu'on déplace ni d'écran qu'on efface :
#  les programmes PLEIN ÉCRAN (vim, nano, htop, less, man…) ne peuvent pas
#  s'y afficher. Le Terminal classique (xfce4-terminal) reste installé et
#  atteignable — « lexos-pro-terminal --classique », ou le clic droit sur
#  l'icône du dock — pour ceux-là et pour tout script qui a besoin d'un vrai
#  pty (Claude Code, OpenCode, l'installation d'un paquet qui pose une
#  question en cours de route).
#
#  ── LE FILET : SI CETTE FENÊTRE NE PEUT PAS S'OUVRIR ────────────────────
#  Un Paramètres cassé laisse quand même un système utilisable. Un TERMINAL
#  cassé, quand il a remplacé le seul raccourci qu'on connaît (Super+T, le
#  dock), laisse un système où on ne peut plus rien lancer du tout. Alors
#  si PySide6 WebEngine manque, on ne meurt pas en silence derrière un
#  raccourci clavier : on ouvre le Terminal classique à la place.
# =============================================================================
set -uo pipefail

PROG="${0##*/}"
if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; E=$'\033[31m'; Y=$'\033[33m'; D=$'\033[2m'; R=$'\033[0m'
else
	O=''; E=''; Y=''; D=''; R=''
fi
say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

CODE="/usr/lib/lexos/terminal-pro.py"
DONNEES="${LEXOS_TERMINAL_PRO_WEB:-/usr/share/lexos/terminal-pro/web}"

classique() {
	#  ═══ JAMAIS « x-terminal-emulator » ICI : IL POINTE SUR NOUS ═══
	#  CE QUE ÇA FAISAIT AVANT : cette liste commençait par
	#  « x-terminal-emulator », par symétrie avec lexos-ouvrir et
	#  lexos-welcome. La symétrie était le piège : chez EUX, l'alternative
	#  Debian désigne un terminal. Ici, le hook 0455 l'a rebranchée sur
	#  lexos-pro-terminal.wrapper, qui fait « exec /usr/bin/lexos-pro-terminal ».
	#  Autrement dit, notre filet de secours nous rappelait NOUS.
	#
	#  MESURÉ, en reproduisant la vraie machine (x-terminal-emulator branché
	#  sur le pont, PySide6 absent) :
	#      « lexos-pro-terminal --classique » : tué au bout de 8 s (code 124),
	#      1222 passages dans ce lanceur, xfce4-terminal lancé 0 fois.
	#  Deux conséquences, et la seconde est la pire :
	#    · le menu « Terminal classique » ouvrait le terminal Pro ;
	#    · sur une machine SANS PySide6 — précisément celle où ce filet est
	#      la dernière chance d'avoir un terminal — la boucle est infinie.
	#      Le seul raccourci que l'on connaît, Super+T, ne donne plus rien
	#      du tout et occupe un cœur.
	#
	#  On nomme donc les vrais terminaux, et on REFUSE tout chemin qui
	#  revient sur ce programme — la garde vaut pour le prochain pont, pas
	#  seulement pour celui d'aujourd'hui.
	#  ON CHOISIT DANS LA BOUCLE, ON REMPLACE APRÈS. Le « exec » nu au
	#  milieu d'une boucle fait dire à shellcheck 0.9 — celui du coureur —
	#  « Remove exec if script should continue after this command » (SC2093).
	#  Il a raison de s'en méfier : à cet endroit, rien ne distingue à la
	#  lecture un remplacement voulu d'un « exec » posé par erreur au milieu
	#  d'un traitement. La forme « … && exec » est celle que le fichier
	#  employait avant, et celle que shellcheck accepte : le remplacement
	#  devient visiblement conditionnel, et il est la DERNIÈRE chose que
	#  cette fonction fait.
	local MOI CHEMIN CIBLE CHOISI T
	MOI="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
	CHOISI=""
	for T in xfce4-terminal gnome-terminal konsole mate-terminal xterm; do
		CHEMIN="$(command -v "$T" 2>/dev/null)" || continue
		[[ -n "$CHEMIN" ]] || continue
		CIBLE="$(readlink -f "$CHEMIN" 2>/dev/null || printf '%s' "$CHEMIN")"
		#  Ni nous-mêmes, ni notre pont : les deux ramèneraient ici.
		[[ "$CIBLE" == "$MOI" ]] && continue
		[[ "$CIBLE" == *lexos-pro-terminal* ]] && continue
		CHOISI="$CHEMIN"
		break
	done
	[[ -n "$CHOISI" ]] && exec "$CHOISI"
	die "Aucun terminal classique disponible (xfce4-terminal, gnome-terminal, konsole, mate-terminal ou xterm)."
}

case "${1:-}" in
	-h|--help|aide|help)
		cat <<AIDE
${PROG} — LexOS Pro Terminal

  ${O}${PROG}${R}              Ouvre LexOS Pro Terminal (le terminal officiel)
  ${O}${PROG} --classique${R}  Ouvre le Terminal classique (xfce4-terminal)

Onglets, fenêtres divisibles, les vraies commandes du système. Les
programmes plein écran (vim, nano, htop, less, man…) ont besoin du
Terminal classique — ${O}${PROG} --classique${R}.
AIDE
		exit 0 ;;
	--classique|classique) classique ;;
esac

[[ -r "$CODE" ]]        || die "Fichier manquant : $CODE"
[[ -d "$DONNEES" ]]     || die "Fichiers de l'interface introuvables : $DONNEES"

#  PySide6 vient des paquets Debian, jamais de « pip --break-system-packages » :
#  ce commutateur écrase des fichiers appartenant à dpkg et finit par casser
#  des logiciels sans rapport (même règle que lexos-settings).
if ! python3 -c "import PySide6.QtWebEngineWidgets" >/dev/null 2>&1; then
	warn "Le composant Qt WebEngine de PySide6 est absent — ouverture du Terminal classique à la place."
	say  "   ${D}sudo apt install python3-pyside6.qtwebenginewidgets python3-pyside6.qtwidgets${R}"
	classique
fi

#  ── LE MÊME FILET, POUR LE PSEUDO-TERMINAL ──────────────────────────────
#  Depuis que le terminal repose sur un VRAI pty (pty.fork), la fenêtre n'a
#  plus rien à montrer si le noyau ne peut pas en ouvrir un : /dev/pts non
#  monté, la limite kernel.pty.max atteinte, un conteneur sans devpts. Une
#  fenêtre qui s'ouvre sur un shell mort est PIRE qu'une fenêtre qui ne
#  s'ouvre pas — on ne comprend pas pourquoi rien ne répond. Même règle que
#  ci-dessus : on bascule sur le Terminal classique, on ne meurt pas en
#  silence derrière un raccourci clavier.
if ! python3 -c "
import os, pty
m, e = pty.openpty()
os.close(m); os.close(e)
" >/dev/null 2>&1; then
	warn "Impossible d'ouvrir un pseudo-terminal (/dev/pts) — ouverture du Terminal classique à la place."
	classique
fi

exec python3 "$CODE" "$@"
