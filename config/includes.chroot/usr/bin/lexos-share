#!/usr/bin/env bash
# =============================================================================
#  lexos-share — partager des fichiers avec un téléphone ou un autre appareil
# =============================================================================
#  Trois moyens, du plus universel au plus spécialisé :
#
#    qr    QR code + page web locale — marche avec N'IMPORTE QUEL téléphone,
#          sans rien installer. Scanner le code suffit.
#    kde   KDE Connect — appareils appairés, transfert direct, façon AirDrop.
#    bt    Bluetooth — quand il n'y a pas de réseau du tout.
#
#  Le partage web s'arrête tout seul au bout de quelques minutes.
# =============================================================================
set -uo pipefail

PROG="${0##*/}"
#  Le chemin est ouvrable de l'extérieur pour que le banc d'essai puisse
#  jouer un partage complet depuis l'arbre du dépôt, sans rien installer.
#  En usage normal la valeur par défaut s'applique et personne n'a à
#  connaître cette variable — même couture que LEXOS_TMUX_CONF.
SERVER="${LEXOS_SHARE_SERVER:-/usr/lib/lexos/share-server.py}"
#  L'ouvre-porte du pare-feu. Il tourne en root par pkexec ; le chemin est
#  ouvrable de l'extérieur pour que le banc puisse lui substituer un faux et
#  vérifier ce qui lui est RÉELLEMENT demandé, sans toucher au pare-feu de la
#  machine qui fait tourner le banc.
PARE_FEU="${LEXOS_PARTAGE_PARE_FEU:-/usr/lib/lexos/partage-pare-feu}"
#  Le port qu'on a ouvert soi-même, et qu'on refermera en partant. Vide tant
#  qu'on n'a rien ouvert : la fermeture n'est jamais déclenchée à tort.
PORT_OUVERT_PAR_NOUS=""

#  ═══ REFERMER, MÊME QUAND ÇA SE PASSE MAL ═══
#  Un port laissé ouvert après un partage est pire que le partage lui-même :
#  personne ne le voit, et il survit au redémarrage puisque ufw enregistre
#  ses règles. Le piège EXIT couvre les trois sorties — la fin normale, le
#  Ctrl+C, et le « die » d'une erreur en chemin.
#  ═══ UN SEUL PIÈGE, ET TROIS CHOSES À DÉFAIRE ═══
#  ATTENTION EN TOUCHANT À CECI : « trap … EXIT » REMPLACE le piège précédent,
#  il ne s'y ajoute pas. cmd_qr posait déjà le sien (« rm -rf $stage ») ; un
#  second trap EXIT écrit plus haut aurait été effacé en silence au moment
#  même où le partage démarre — et le port serait resté ouvert précisément
#  dans le seul cas qui compte. On garde donc UN seul piège, ici, et cmd_qr
#  lui confie ce qu'il a à défaire au lieu d'en poser un deuxième.
STAGE_A_EFFACER=""
PORT_OUVERT_PAR_NOUS=""
SERVEUR_PID=""

#  L'ORDRE COMPTE : on cesse d'abord de servir, on referme ensuite. L'inverse
#  laisserait une fenêtre — courte, mais réelle — où le port est déjà fermé
#  pendant qu'un transfert en cours se fait couper au milieu.
tout_fermer() {
	#  LE SERVEUR SURVIVAIT AU Ctrl+C, ET ÇA NE SE VOYAIT NULLE PART. Mesuré en
	#  jouant l'arrêt de bout en bout : sans fenêtre — en console, par SSH — la
	#  commande finissait sur un simple « wait "$pid" », et un Ctrl+C rendait la
	#  main sans rien arrêter. Le partage continuait de servir des fichiers sur
	#  le réseau pendant que l'écran disait « Partage fermé ». La branche AVEC
	#  fenêtre, elle, tuait bien le serveur : le défaut ne vivait que là où
	#  personne ne regarde. Il est pire depuis qu'on ouvre un port — on
	#  refermait la porte en laissant le serveur derrière.
	if [[ -n "$SERVEUR_PID" ]]; then
		kill "$SERVEUR_PID" 2>/dev/null || true
		SERVEUR_PID=""
	fi
	#  Un port laissé ouvert est pire que le partage lui-même : personne ne le
	#  voit, et il survit au redémarrage puisque ufw enregistre ses règles.
	if [[ -n "$PORT_OUVERT_PAR_NOUS" ]]; then
		pkexec "$PARE_FEU" fermer "$PORT_OUVERT_PAR_NOUS" >/dev/null 2>&1 || true
		PORT_OUVERT_PAR_NOUS=""
	fi
	if [[ -n "$STAGE_A_EFFACER" ]]; then
		rm -rf "$STAGE_A_EFFACER"
		STAGE_A_EFFACER=""
	fi
}
#  ═══ ET LE PIÈGE DOIT SORTIR, SINON IL AVALE LE Ctrl+C ═══
#  Écrit d'abord « trap tout_fermer EXIT INT TERM ». Mesuré aussitôt après :
#  la commande ne s'arrêtait PLUS du tout. Un gestionnaire de signal en bash
#  s'exécute et REND LA MAIN — il ne termine pas le programme. Avant ce
#  correctif il n'y avait aucun piège sur INT, et Ctrl+C tuait le processus
#  net ; en posant le piège on avait remplacé « ça s'arrête » par « ça fait le
#  ménage et ça continue ». On nettoie donc, PUIS on sort, avec les codes
#  d'usage (130 = interrompu, 143 = terminé). tout_fermer() vide ses variables
#  en passant : le piège EXIT, déclenché ensuite par ce « exit », ne refait
#  rien deux fois.
trap tout_fermer EXIT
trap 'tout_fermer; exit 130' INT
trap 'tout_fermer; exit 143' TERM
#  LA FENÊTRE DU PARTAGE. Elle n'est PAS le serveur : share-server.py écoute
#  sur le réseau pour que le téléphone l'atteigne, partage.py ne fait
#  qu'AFFICHER l'adresse déjà servie. Un seul chemin démarre un serveur, un
#  seul l'arrête — sinon on finit un jour avec un serveur oublié en train de
#  servir le dossier personnel sur le réseau.
PANNEAU="${LEXOS_PARTAGE_PY:-/usr/lib/lexos/partage.py}"
RECV_DIR="${XDG_DOWNLOAD_DIR:-$HOME/Téléchargements}"
[[ -d "$RECV_DIR" ]] || RECV_DIR="$HOME/Downloads"
[[ -d "$RECV_DIR" ]] || RECV_DIR="$HOME"
RECV_DIR="$RECV_DIR/LexOS-reçus"

MINUTES=15

case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
	*UTF-8*|*utf8*|*UTF8*|*utf-8*) ;;
	*) locale -a 2>/dev/null | grep -qiE '^C\.utf-?8$' && export LC_ALL=C.UTF-8 ;;
esac

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
	O=$'\033[38;5;208m'; A=$'\033[38;5;215m'; D=$'\033[2m'
	G=$'\033[32m'; Y=$'\033[33m'; E=$'\033[31m'; B=$'\033[1m'; R=$'\033[0m'
else
	O=''; A=''; D=''; G=''; Y=''; E=''; B=''; R=''
fi

say()  { printf '%s»%s %s\n' "$O" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$R" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

# =============================================================================
#  Partage par QR code (aucune application requise sur le téléphone)
# =============================================================================
cmd_qr() {
	[[ -r "$SERVER" ]] || die "Serveur de partage introuvable : $SERVER"
	command -v python3 >/dev/null 2>&1 || die "python3 est requis."

	local stage
	stage="$(mktemp -d -t lexos-share-XXXXXX)" || die "Dossier temporaire impossible."
	#  On CONFIE le dossier au piège commun au lieu d'en poser un deuxième :
	#  « trap … EXIT » remplace, il n'ajoute pas. Voir tout_fermer(), plus haut.
	STAGE_A_EFFACER="$stage"

	local n=0 f
	for f in "$@"; do
		[[ -f "$f" ]] || { warn "Ignoré (pas un fichier) : $f"; continue; }
		ln "$f" "$stage/$(basename "$f")" 2>/dev/null \
			|| cp "$f" "$stage/$(basename "$f")" \
			|| { warn "Copie impossible : $f"; continue; }
		n=$((n + 1))
	done

	mkdir -p "$RECV_DIR"

	if (( n == 0 )) && [[ $# -gt 0 ]]; then
		die "Aucun fichier partageable."
	fi

	say "Démarrage du partage local…"
	local out url
	out="$(mktemp -t lexos-share-url-XXXXXX)"
	python3 "$SERVER" --dir "$stage" --recv "$RECV_DIR" --minutes "$MINUTES" \
		> >(tee "$out") 2>/dev/null &
	local pid=$!
	#  Le piège commun a besoin de ce numéro : c'est lui qui arrête le serveur
	#  quand la commande finit autrement que par sa fin normale.
	SERVEUR_PID="$pid"

	# La première ligne écrite par le serveur est l'URL.
	local tries=0
	while [[ ! -s "$out" ]] && (( tries < 50 )); do sleep 0.1; tries=$((tries + 1)); done
	url="$(head -n1 "$out")"
	rm -f "$out"

	if [[ -z "$url" ]]; then
		kill "$pid" 2>/dev/null
		die "Le serveur de partage n'a pas démarré."
	fi

	# =========================================================================
	#  LE PARE-FEU — LA CAUSE LA PLUS PROBABLE, ET ON LA TRAITE
	# =========================================================================
	#  ALEX : « on n'est pas capable de partager réellement, même quand je
	#  scanne le code QR ». Le serveur répondait, le QR était juste. Entre les
	#  deux, « lexos secure enable » avait posé « ufw default deny incoming ».
	#
	#  On demande l'état AVANT d'ouvrir, pour deux raisons : ne pas réclamer un
	#  mot de passe quand il n'y a pas de pare-feu (le cas courant), et ne pas
	#  REFERMER en partant un port que l'utilisateur avait ouvert lui-même.
	PORT="${url##*:}"; PORT="${PORT%%/*}"
	PARE_FEU_ETAT="inconnu"
	if [[ "$PORT" =~ ^[0-9]+$ ]] && [[ -x "$PARE_FEU" ]]; then
		#  L'état se lit SANS élévation quand on peut : « ufw status » exige
		#  root, donc on passe par pkexec — mais seulement si un agent existe
		#  pour poser la question. Sans agent, pkexec échoue en silence et le
		#  partage doit continuer quand même : un pare-feu qu'on n'a pas pu
		#  interroger ne doit pas empêcher de partager sur un réseau où il
		#  n'est peut-être même pas actif.
		if command -v ufw >/dev/null 2>&1; then
			PARE_FEU_ETAT="$(pkexec "$PARE_FEU" etat "$PORT" 2>/dev/null || printf 'inconnu')"
		else
			PARE_FEU_ETAT="absent"
		fi
	fi
	#  ═══ ON NE PASSE QUE DES MOTS CONNUS À LA FENÊTRE ═══
	#  partage.py déclare « --pare-feu » avec une liste fermée : une valeur
	#  inattendue — un message d'erreur de pkexec, une ligne vide, une sortie
	#  traduite — ferait REFUSER la fenêtre par argparse, et le partage
	#  n'afficherait plus rien du tout. On ramène donc tout le reste à
	#  « inconnu », qui est justement là pour ça.
	case "$PARE_FEU_ETAT" in
		absent|inactif|ouvert|ferme) ;;
		*) PARE_FEU_ETAT="inconnu" ;;
	esac

	if [[ "$PARE_FEU_ETAT" == "ferme" ]]; then
		say "Pare-feu actif : ouverture du port ${PORT} pour la durée du partage…"
		if [[ "$(pkexec "$PARE_FEU" ouvrir "$PORT" 2>/dev/null)" == "ouvert" ]]; then
			#  ON NOTE QU'ON L'A OUVERT : c'est cette variable, et elle seule,
			#  qui autorise la fermeture en partant. Sans elle, un partage
			#  refermerait un port que quelqu'un d'autre avait ouvert.
			PORT_OUVERT_PAR_NOUS="$PORT"
			#  Et l'état SUIT : sans cette ligne, la fenêtre annoncerait
			#  « Pare-feu à ouvrir » sur un port qu'on vient d'ouvrir.
			PARE_FEU_ETAT="ouvert"
			ok "Port ${PORT} ouvert."
		else
			warn "Le port n'a pas pu être ouvert : le téléphone n'atteindra peut-être pas la page."
			warn "À la main : sudo ufw allow ${PORT}/tcp"
		fi
	fi

	# =========================================================================
	#  UNE VRAIE FENÊTRE, ET NON UN QR CODE EN CARACTÈRES
	# =========================================================================
	#  ALEX, PHOTO DE L'ISO 72 : « la page pour partager, elle est pas pareille ».
	#  Il a raison. La démo montre une page — un titre, un QR net, l'adresse en
	#  orange, deux explications. L'ISO, elle, ouvrait un TERMINAL et y dessinait
	#  le QR avec des blocs de texte. Même information, deux produits.
	#
	#  Un QR en caractères, ce n'est pas seulement moins beau : selon la police
	#  et l'espacement des lignes du terminal, les modules ne sont pas carrés, et
	#  l'appareil photo du téléphone peut refuser de le lire. C'est le genre de
	#  chose qui marche chez celui qui l'a écrit et pas chez l'autre.
	#
	#  On rend donc un vrai PNG et on l'affiche dans une fenêtre. Le terminal
	#  reste le REPLI : sans serveur graphique, sans Qt, ou sans le panneau —
	#  en console, en mode secours, par SSH — le QR en caractères vaut toujours
	#  mieux que rien. La commande garde ainsi sa raison d'être là où il n'y a
	#  pas de bureau.
	#
	#  ═══ CE N'EST PLUS UNE FENÊTRE yad ═══
	#  Elle l'a été, et elle ne pouvait pas ressembler au reste : un dialogue
	#  GTK générique ne prend pas le thème LexOS, et son bouton reste celui du
	#  thème GTK courant. On passe au patron de tous les autres panneaux — une
	#  page web locale dans une fenêtre Qt (settings.py, volet.py, cartes.py) —
	#  parce que c'est le seul moyen SÛR que l'apparence reste la même partout,
	#  plutôt que de redessiner à la main d'un panneau à l'autre.
	fenetre_qr() {
		#  ═══ QUATRE RAISONS DE NE PAS S'AFFICHER, ET ELLES RENDENT TOUTES 1 ═══
		#  Ce « return 1 » est ce qui fait retomber la commande sur le QR en
		#  caractères, plus bas. Sans lui, « lexos share qr » ne servirait plus à
		#  rien sur une machine sans bureau graphique — en console, en mode
		#  secours, par SSH — là où c'est justement le plus utile.
		[[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || return 1
		command -v python3 >/dev/null 2>&1 || return 1
		[[ -r "$PANNEAU" ]] || return 1
		#  ON DEMANDE L'IMPORT, ON NE CHERCHE PAS LE FICHIER. Le paquet peut être
		#  posé sans que l'import marche — mauvaise architecture, Qt incomplet.
		#  La seule question qui compte est « est-ce que ça démarre ? ».
		python3 -c 'import PySide6.QtWebEngineWidgets' >/dev/null 2>&1 || return 1

		#  Ce qu'on montre, c'est ce que le téléphone verra : le contenu du
		#  dossier temporaire, et non les chemins d'origine — un fichier écarté
		#  plus haut (illisible, copie impossible) n'y est pas.
		local -a partages=()
		(( n > 0 )) && partages=("$stage"/*)

		#  ON PASSE CE QU'ON A TROUVÉ DU PARE-FEU. La fenêtre ne peut pas
		#  le redemander : « ufw status » exige root, et réclamer un mot de
		#  passe pour afficher une ligne d'état serait insupportable. Ici on
		#  vient de poser la question — autant la transmettre.
		python3 "$PANNEAU" \
			--url "$url" --recus "$RECV_DIR" --minutes "$MINUTES" \
			--pare-feu "$PARE_FEU_ETAT" \
			"${partages[@]}" >/dev/null 2>&1 &
		#  LE PID EST LE CONTRAT AVEC LA SUITE : le « wait -n » plus bas attend
		#  la première des deux fins — la fenêtre ou Ctrl+C — pour arrêter le
		#  serveur. Sans ce PID, fermer la fenêtre laisserait le partage ouvert.
		FENETRE_PID=$!
		return 0
	}

	#  Le fichier temporaire du QR a disparu avec la fenêtre yad : l'image est
	#  maintenant fabriquée par le panneau et rendue en data: URI dans la page.
	#  Il n'y a plus rien à retirer après coup.
	FENETRE_PID=""
	printf '\n'
	if ! fenetre_qr; then
		#  Le repli, et il est assumé : en console il n'y a pas de fenêtre à
		#  ouvrir, et un QR en caractères se scanne quand même la plupart du
		#  temps. Mieux vaut ça qu'une commande qui refuse de servir.
		if command -v qrencode >/dev/null 2>&1; then
			qrencode -t ANSIUTF8 -m 2 "$url"
		else
			warn "qrencode absent — installe-le pour afficher le QR code."
		fi
	fi

	printf '\n  %s%s%s\n\n' "$B$O" "$url" "$R"
	if (( n > 0 )); then
		printf '  %s fichier(s) partagé(s).\n' "$n"
	fi
	printf '  Scanne le code avec l%sappareil photo du téléphone,\n' "'"
	printf '  ou tape l%sadresse dans son navigateur.\n\n' "'"
	printf '  %sTu peux aussi t%senvoyer des fichiers DEPUIS le téléphone :%s\n' "$D" "'" "$R"
	printf '  %sils arrivent dans %s%s\n\n' "$D" "$RECV_DIR" "$R"
	printf '  %sArrêt automatique dans %s min — ou Ctrl+C tout de suite.%s\n\n' \
		"$D" "$MINUTES" "$R"

	if command -v notify-send >/dev/null 2>&1; then
		notify-send -i network-wireless "LexOS — partage ouvert" "$url" 2>/dev/null || true
	fi

	#  DEUX FAÇONS D'ARRÊTER, ET LA PREMIÈRE QUI VIENT GAGNE : le bouton de la
	#  fenêtre, ou Ctrl+C dans le terminal. Sans ce guet, fermer la fenêtre
	#  laissait le serveur tourner — un partage qu'on croit fermé et qui ne
	#  l'est pas, c'est la pire des deux issues.
	if [[ -n "$FENETRE_PID" ]]; then
		wait -n "$pid" "$FENETRE_PID" 2>/dev/null || true
		kill "$pid" "$FENETRE_PID" 2>/dev/null || true
		wait "$pid" "$FENETRE_PID" 2>/dev/null || true
	else
		wait "$pid" 2>/dev/null
	fi
	printf '\n'
	ok "Partage fermé."
}

# =============================================================================
#  KDE Connect
# =============================================================================
kde_devices() {
	kdeconnect-cli --list-available --id-name-only 2>/dev/null
}

cmd_kde() {
	command -v kdeconnect-cli >/dev/null 2>&1 \
		|| die "KDE Connect n'est pas installé (paquet kdeconnect)."

	local files=() target=""
	local a
	for a in "$@"; do
		if [[ -f "$a" ]]; then files+=("$a"); else target="$a"; fi
	done

	local devices; devices="$(kde_devices)"
	if [[ -z "$devices" ]]; then
		warn "Aucun appareil KDE Connect joignable."
		printf '  1. Installe « KDE Connect » sur le téléphone (Android/iOS, gratuit).\n'
		printf '  2. Mets les deux appareils sur le %sMÊME réseau Wi-Fi%s.\n' "$B" "$R"
		printf '  3. Appaire-les, puis relance cette commande.\n'
		return 1
	fi

	if [[ -z "$target" ]]; then
		local count; count="$(wc -l <<< "$devices")"
		if (( count == 1 )); then
			target="$(awk '{print $1}' <<< "$devices")"
		else
			printf '\nPlusieurs appareils disponibles :\n\n'
			printf '%s\n' "$devices" | sed 's/^/  /'
			printf '\n  %s%s kde <fichier> <identifiant>%s\n\n' "$D" "$PROG" "$R"
			return 1
		fi
	fi

	(( ${#files[@]} )) || die "Aucun fichier à envoyer."

	local f rc=0
	for f in "${files[@]}"; do
		if kdeconnect-cli --device "$target" --share "$f" >/dev/null 2>&1; then
			ok "Envoyé : $(basename "$f")"
		else
			warn "Échec : $(basename "$f")"; rc=1
		fi
	done
	return $rc
}

# =============================================================================
#  Bluetooth
# =============================================================================
cmd_bt() {
	command -v bluetooth-sendto >/dev/null 2>&1 \
		|| command -v obexctl >/dev/null 2>&1 \
		|| die "Envoi Bluetooth indisponible (paquets blueman ou bluez-obexd)."

	local files=() target=""
	local a
	for a in "$@"; do
		if [[ -f "$a" ]]; then files+=("$a"); else target="$a"; fi
	done
	(( ${#files[@]} )) || die "Aucun fichier à envoyer."

	if command -v bluetooth-sendto >/dev/null 2>&1; then
		say "Ouverture de l'assistant Bluetooth…"
		if [[ -n "$target" ]]; then
			bluetooth-sendto --device="$target" "${files[@]}" &
		else
			bluetooth-sendto "${files[@]}" &
		fi
		ok "Choisis l'appareil dans la fenêtre qui s'ouvre."
		return 0
	fi
	die "Utilise l'assistant graphique : bluetooth-sendto"
}

# =============================================================================
#  Appareils connus
# =============================================================================
cmd_devices() {
	printf '\n%sAppareils joignables%s\n' "$B$O" "$R"

	printf '\n  %sKDE Connect%s  %s(Wi-Fi, application à installer sur le téléphone)%s\n' \
		"$A" "$R" "$D" "$R"
	if command -v kdeconnect-cli >/dev/null 2>&1; then
		local d; d="$(kde_devices)"
		if [[ -n "$d" ]]; then
			printf '%s\n' "$d" | sed 's/^/    /'
		else
			printf '    %saucun appareil appairé et joignable%s\n' "$D" "$R"
		fi
	else
		printf '    %snon installé%s\n' "$D" "$R"
	fi

	printf '\n  %sBluetooth%s  %s(appareils appairés)%s\n' "$A" "$R" "$D" "$R"
	if command -v bluetoothctl >/dev/null 2>&1; then
		local b
		b="$(bluetoothctl devices Paired 2>/dev/null || bluetoothctl paired-devices 2>/dev/null)"
		if [[ -n "$b" ]]; then
			printf '%s\n' "$b" | sed 's/^Device /    /'
		else
			printf '    %saucun appareil appairé%s  %s(lexos net bt scan)%s\n' "$D" "$R" "$D" "$R"
		fi
	else
		printf '    %snon installé%s\n' "$D" "$R"
	fi

	printf '\n  %sQR code%s  %s(marche avec tout téléphone, rien à installer)%s\n' \
		"$A" "$R" "$D" "$R"
	printf '    %s%s qr <fichier…>%s\n\n' "$D" "$PROG" "$R"
}

# =============================================================================
#  Le nom de la machine — celui que les autres appareils voient
# =============================================================================
#  POURQUOI C'EST ICI, ET PAS AILLEURS.
#  ALEX : « le contenu comme Ubuntu ». Ubuntu met le nom de l'ordinateur EN
#  HAUT de sa page « Partage », et pour une bonne raison : ce nom n'a d'usage
#  que vu d'ailleurs. C'est lui qui s'affiche dans la liste des appareils du
#  téléphone, dans KDE Connect, sur le réseau, et dans l'invite du terminal.
#  « lexos-share » est justement l'outil de ce qui se voit d'ailleurs.
#
#  LE PIÈGE QUE PERSONNE NE VOIT VENIR : /etc/hosts.
#  Changer /etc/hostname sans toucher à la ligne « 127.0.1.1 » de /etc/hosts
#  laisse un système où le nom de la machine ne se résout plus. Le symptôme
#  n'a rien à voir avec le nom : chaque sudo attend, puis affiche
#  « sudo: unable to resolve host … ». On règle donc les deux, ou rien.

#  ═══ LES DEUX FICHIERS DU NOM, ET LE SEUIL QUI PERMET DE LES ÉPROUVER ═══
#  LEXOS_HOSTNAME_RACINE déplace À LA FOIS /etc/hostname et /etc/hosts sous un
#  dossier à part. Vide — le cas normal, et le seul en usage réel —, les deux
#  chemins restent ceux du système.
#
#  POURQUOI CE SEUIL EXISTE, ET POURQUOI IL EST HONNÊTE.
#  Renommer la machine écrit dans /etc : l'outil exige donc les droits
#  d'administrateur. Un banc d'essai, lui, ne les a pas — le coureur de la CI
#  n'est pas root — et sans ce seuil, la partie la plus utile de ce code (la
#  mise à jour de la ligne 127.0.1.1, celle qui évite « sudo: unable to
#  resolve host ») ne serait éprouvée NULLE PART où ça compte. Un banc qui ne
#  tourne pas là où le code tourne ne protège rien.
#
#  Ce seuil ne donne aucun droit : il déplace les écritures dans un dossier
#  que l'appelant possède déjà. C'est exactement le procédé déjà employé dans
#  ce dépôt par LEXOS_BIENETRE_DIR, LEXOS_NUAGE, LEXOS_RCLONE_REMOTES et
#  LEXOS_DATE, et pour la même raison.
RACINE_NOM="${LEXOS_HOSTNAME_RACINE:-}"
HOSTS="${RACINE_NOM}/etc/hosts"
HOSTNAME_F="${RACINE_NOM}/etc/hostname"

nom_actuel() {
	#  Sous le seuil, on ne demande PAS à hostnamectl : il répondrait le vrai
	#  nom de la machine, pas celui du décor, et le banc éprouverait autre
	#  chose que ce qu'il croit.
	if [[ -n "$RACINE_NOM" ]]; then
		cat "$HOSTNAME_F" 2>/dev/null || printf 'inconnu\n'
		return 0
	fi
	hostnamectl --static 2>/dev/null || cat "$HOSTNAME_F" 2>/dev/null || uname -n
}

# Les règles d'un nom de machine (RFC 1123), écrites UNE fois : la commande
# les applique, « --json » les publie pour que la page des Paramètres refuse
# un nom fautif sans ouvrir un terminal pour rien.
REGEX_NOM_MACHINE='^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$'

cmd_nom() {
	local neuf="${1:-}" avant=""
	avant="$(nom_actuel)"
	if [[ -z "$neuf" ]]; then
		say "Nom de cette machine : ${B}${avant}${R}"
		say "C'est ce nom que voient les autres appareils du réseau."
		say "Changer :  ${B}sudo $PROG nom <nouveau-nom>${R}"
		return 0
	fi
	[[ "$neuf" =~ $REGEX_NOM_MACHINE ]] \
		|| die "Nom de machine invalide : « $neuf ». Lettres, chiffres et « - » seulement, 63 caractères au plus, et pas de « - » au début ni à la fin."
	if [[ "$neuf" == "$avant" ]]; then
		say "La machine s'appelle déjà « $neuf » — rien à changer."
		return 0
	fi
	#  Sous le seuil, il n'y a plus rien de partagé à écrire : root n'a plus
	#  de raison d'être exigé.
	if [[ -z "$RACINE_NOM" ]] && (( EUID != 0 )); then
		warn "Changer le nom de la machine touche à tout le système."
		die "Relancez :  ${B}sudo $PROG nom $neuf${R}"
	fi

	if [[ -n "$RACINE_NOM" ]]; then
		mkdir -p "$(dirname "$HOSTNAME_F")" 2>/dev/null || true
		printf '%s\n' "$neuf" > "$HOSTNAME_F" \
			|| die "Impossible d'écrire $HOSTNAME_F."
	elif command -v hostnamectl >/dev/null 2>&1; then
		hostnamectl set-hostname "$neuf" || die "hostnamectl a refusé « $neuf »."
	else
		printf '%s\n' "$neuf" > "$HOSTNAME_F" || die "Impossible d'écrire $HOSTNAME_F."
		hostname "$neuf" 2>/dev/null || true
	fi

	# ═══ ET /etc/hosts, SANS QUOI CHAQUE SUDO ATTENDRA ═══
	# Une seule sauvegarde, faite avant la première modification : c'est
	# l'état livré par Debian qu'on veut pouvoir retrouver, pas les dix essais
	# d'après. Même procédé que la connexion automatique de
	# lexos-utilisateurs, et pour la même raison.
	if [[ -w "$HOSTS" ]]; then
		[[ -e "$HOSTS.lexos-avant" ]] || cp -a "$HOSTS" "$HOSTS.lexos-avant"
		local tmp=""
		tmp="$(mktemp)" || die "Fichier temporaire impossible."
		# On réécrit la ligne 127.0.1.1 si elle existe, on l'ajoute sinon.
		# « cat > » et non « mv » : le fichier garde son inode et ses droits.
		if awk -v n="$neuf" '
			/^127\.0\.1\.1[ \t]/ { print "127.0.1.1\t" n; pose = 1; next }
			{ print }
			END { if (!pose) print "127.0.1.1\t" n }
		' "$HOSTS" > "$tmp" && cat "$tmp" > "$HOSTS"; then
			rm -f "$tmp"
			ok "Nom de la machine : ${B}$neuf${R}  (127.0.1.1 mis à jour dans $HOSTS)"
		else
			rm -f "$tmp"
			warn "Le nom est changé, mais $HOSTS n'a pas pu être mis à jour :"
			die "chaque sudo attendra puis dira « unable to resolve host $neuf »."
		fi
	else
		warn "$HOSTS n'est pas modifiable : chaque sudo risque d'attendre puis"
		warn "de dire « unable to resolve host $neuf ». À corriger à la main."
	fi
	say "L'ancien nom (« $avant ») reste affiché dans les fenêtres déjà ouvertes."
	say "Le terminal et l'écran de connexion prennent le nouveau au prochain démarrage."
}

# =============================================================================
#  L'état, pour la page des Paramètres
# =============================================================================
#  --json : ce que la page « Partage » a besoin de savoir, et qu'elle ne peut
#  pas deviner. Elle affichait UNE ligne — « serveur actif / au repos » — et
#  rien d'autre : ni le nom de la machine, ni où arrivent les fichiers reçus,
#  ni lesquels des trois moyens de transfert sont réellement là. Un moyen
#  absent qu'on présente comme disponible envoie cliquer dans le vide.
#
#  Aucune valeur ne vient d'ailleurs que de nos tables, sauf le nom de la
#  machine et le dossier de réception ; tous deux sont échappés.
_lib_json="$(dirname "$(readlink -f "$0")")/../share/lexos/shell/json.sh"
[[ -r $_lib_json ]] || _lib_json=/usr/share/lexos/shell/json.sh
if [[ -r $_lib_json ]]; then
	# shellcheck source=/dev/null
	. "$_lib_json"
else
	json_texte() { die "json.sh est introuvable : impossible d'écrire du JSON sûr."; }
fi

cmd_json() {
	local actif=false
	#  ON CHERCHE LE CHEMIN COMPLET, pas « share-server.py ». « pgrep -f »
	#  compare la ligne de commande ENTIÈRE de chaque processus : le motif
	#  court se reconnaît dans n'importe quelle commande qui mentionne ce nom
	#  — un éditeur ouvert sur le fichier, un grep, un banc d'essai — et le
	#  partage s'annonçait alors « actif » alors que rien ne tournait. Vu ici
	#  même : le premier « --json » de ce script a répondu « actif » parce que
	#  la commande qui le lançait contenait le mot.
	command -v pgrep >/dev/null 2>&1 && pgrep -f "$SERVER" >/dev/null 2>&1 && actif=true
	printf '{\n'
	printf '  "nom": "%s",\n' "$(json_texte "$(nom_actuel)")"
	printf '  "nom_regex": "%s",\n' "$REGEX_NOM_MACHINE"
	printf '  "actif": %s,\n' "$actif"
	printf '  "recus": "%s",\n' "$(json_texte "$RECV_DIR")"
	printf '  "minutes": %s,\n' "$MINUTES"
	printf '  "kde": %s,\n' "$(command -v kdeconnect-cli >/dev/null 2>&1 && echo true || echo false)"
	printf '  "bt": %s,\n' "$(command -v bluetoothctl >/dev/null 2>&1 && echo true || echo false)"
	printf '  "qr": %s,\n' "$( [[ -r "$SERVER" ]] && command -v python3 >/dev/null 2>&1 && echo true || echo false)"
	#  LE SERVEUR SSH N'EST PAS LIVRÉ AVEC LexOS — seul le client l'est
	#  (openssh-client, dans lexos-core.list.chroot). Ubuntu propose
	#  « Connexion à distance » dans cette page ; on le dit plutôt que de
	#  faire semblant d'avoir un interrupteur qui ne commanderait rien.
	printf '  "ssh_serveur": %s\n}\n' \
		"$(command -v sshd >/dev/null 2>&1 || [[ -x /usr/sbin/sshd ]] && echo true || echo false)"
}

# =============================================================================
#  Réception seule
# =============================================================================
cmd_receive() {
	mkdir -p "$RECV_DIR"
	say "Ouverture d'une boîte de réception."
	cmd_qr
}

# =============================================================================
#  Choix automatique du meilleur moyen
# =============================================================================
cmd_auto() {
	local files=("$@")
	(( ${#files[@]} )) || die "Usage : ${PROG} <fichier…>"

	# Un seul appareil KDE Connect joignable : c'est le plus direct.
	if command -v kdeconnect-cli >/dev/null 2>&1; then
		local d; d="$(kde_devices)"
		if [[ -n "$d" ]] && (( $(wc -l <<< "$d") == 1 )); then
			say "Appareil KDE Connect détecté — envoi direct."
			cmd_kde "${files[@]}" && return 0
			warn "Bascule sur le partage par QR code."
		fi
	fi
	cmd_qr "${files[@]}"
}

cmd_help() {
	cat <<EOF

${B}${O}${PROG}${R} — partager des fichiers et des images

${B}USAGE${R}
  ${PROG} <fichier…>            Choisit tout seul le meilleur moyen
  ${PROG} qr <fichier…>         QR code + page web locale
  ${PROG} kde <fichier…> [id]   Via KDE Connect
  ${PROG} bt  <fichier…>        Via Bluetooth
  ${PROG} devices               Appareils joignables
  ${PROG} receive               Recevoir depuis un téléphone

${B}LE PLUS SIMPLE — LE QR CODE${R}
  ${D}Aucune application à installer sur le téléphone.${R}

    ${A}${PROG} qr photo.jpg${R}

  Un QR code s'affiche dans le terminal. Tu le scannes avec l'appareil
  photo du téléphone, le fichier se télécharge. La même page permet de
  t'envoyer des fichiers DEPUIS le téléphone.

  Les fichiers reçus arrivent dans :
    ${D}${RECV_DIR}${R}

${B}CONDITIONS${R}
  Les deux appareils doivent être sur le ${B}même réseau Wi-Fi${R}.
  Le partage s'arrête tout seul après ${MINUTES} minutes.

EOF
}

# =============================================================================
#  Répartiteur
# =============================================================================
CMD="${1:-help}"

case "$CMD" in
	help|--help|-h) cmd_help ;;
	qr|code)        shift; cmd_qr "$@" ;;
	kde|kdeconnect) shift; cmd_kde "$@" ;;
	bt|bluetooth)   shift; cmd_bt "$@" ;;
	devices|list)   cmd_devices ;;
	nom|name)       shift; cmd_nom "${1:-}" ;;
	--json|json)    cmd_json ;;
	receive|recevoir) cmd_receive ;;
	--minutes)      shift; MINUTES="${1:-15}"; shift; cmd_auto "$@" ;;
	*)              cmd_auto "$@" ;;
esac
