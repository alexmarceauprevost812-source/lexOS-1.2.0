#!/bin/sh
# =============================================================================
#  LexOS — adapter les réglages NVIDIA à la machine où l'on démarre VRAIMENT
# =============================================================================
#  POURQUOI CE SCRIPT EXISTE.
#  L'ISO « pro » embarque le pilote NVIDIA propriétaire parce qu'il ne peut pas
#  s'installer après coup. Elle pose donc aussi, au moment de la construction,
#  deux fichiers dans /etc/modprobe.d/ :
#
#    · lexos-blacklist-nouveau.conf — interdit nouveau, pour que le pilote
#      propriétaire ait la carte pour lui seul (correctif du build 54, trouvé
#      en direct sur l'Alienware : nouveau réclamait la RTX 5060 avant
#      nvidia.ko, et sur Blackwell il ne voit AUCUNE sortie vidéo) ;
#    · lexos-nvidia-drm.conf — active le modesetting de nvidia-drm.
#
#  Ces deux fichiers sont écrits à la CONSTRUCTION, donc sans savoir sur quelle
#  machine l'ISO démarrera. C'est là qu'est le piège, et il est sérieux :
#
#    SUR UNE MACHINE SANS CARTE NVIDIA DU TOUT (le ThinkPad 2016 et ses
#    graphiques Intel), interdire nouveau ne coûte rien — Intel utilise i915.
#    Mais sur une machine à VIEILLE carte NVIDIA, que le pilote 595 ne gère
#    plus, on obtiendrait le pire des deux mondes : nouveau interdit, le
#    propriétaire incapable de prendre la carte, et un écran noir. On aurait
#    reproduit exactement la panne qu'on vient de mettre des semaines à
#    comprendre, mais à l'envers.
#
#  CE QUE FAIT CE SCRIPT. Au démarrage, il regarde s'il y a réellement une
#  carte NVIDIA, et il range ou remet les deux fichiers en conséquence :
#
#    carte NVIDIA présente  → les fichiers sont EN PLACE (rien ne change sur
#                             l'Alienware : le correctif reste entier) ;
#    aucune carte NVIDIA    → ils sont mis de côté en « .sans-nvidia », donc
#                             sans effet, et nouveau reste disponible.
#
#  C'est RÉVERSIBLE ET SYMÉTRIQUE : brancher une carte NVIDIA plus tard, ou
#  déplacer le disque dans une autre tour, remet les fichiers tout seuls au
#  démarrage suivant. Rien n'est jamais supprimé.
#
#  RÉSULTAT : une seule ISO « pro » démarre correctement partout — sur
#  l'Alienware avec sa RTX 5060 comme sur le vieux portable Intel.
# =============================================================================
set -e

JOURNAL="${LEXOS_RACINE:-}/var/log/lexos-gpu-garde.log"
dire() {
	echo "[lexos-gpu-garde] $*"
	printf '%s %s\n' "$(date -Is 2>/dev/null || echo '?')" "$*" >> "$JOURNAL" 2>/dev/null || true
}

#  Préfixe de racine. VIDE en usage normal — il n'existe que pour pouvoir
#  ESSAYER ce script hors d'une vraie machine : le banc d'essai lui donne une
#  fausse arborescence (faux bus PCI, faux /etc/modprobe.d) et vérifie qu'il
#  range et remet les bons fichiers. Sans ça, la seule façon de le tester
#  serait de démarrer deux ordinateurs différents.
R="${LEXOS_RACINE:-}"
PCI="${R}/sys/bus/pci/devices"
MODPROBE="${R}/etc/modprobe.d"
#  /proc/cmdline passe par le même préfixe : c'est lui qui dit si l'on est en
#  session démo, et le banc doit pouvoir jouer ce cas-là aussi. Sans ça, il
#  lirait la ligne de commande de la machine QUI LANCE le banc — et le contrôle
#  « en démo, on ne touche pas à l'initramfs » ne serait jamais éprouvé.
CMDLINE="${R}/proc/cmdline"

REGLAGES="${MODPROBE}/lexos-blacklist-nouveau.conf ${MODPROBE}/lexos-nvidia-drm.conf"
SUFFIXE=".sans-nvidia"

# --- Y a-t-il une carte NVIDIA sur cette machine ? --------------------------
#  On lit /sys directement plutôt que d'appeler lspci : /sys est toujours là,
#  même si pciutils venait à manquer, et c'est la source que lspci lit
#  lui-même. On exige le bon VENDEUR (0x10de = NVIDIA) ET la bonne CLASSE
#  (0x0300 = VGA, 0x0302 = 3D) : une puce audio HDMI NVIDIA, présente sur les
#  mêmes cartes, ne doit pas être prise pour un GPU.
#  ═══ POURQUOI CE SCRIPT N'A PLUS BESOIN DE systemd-udev-settle ═══
#  L'unité tirait « Wants=systemd-udev-settle.service », qui coûtait 2,7 s au
#  démarrage et que systemd déconseille depuis des années. Elle n'était pas
#  nécessaire : les répertoires de /sys/bus/pci/devices et leurs fichiers
#  « vendor » et « class » sont créés par le NOYAU pendant l'énumération PCI,
#  bien avant que le premier programme de l'espace utilisateur ne démarre.
#  udev ne fait ensuite qu'AGIR sur ces devices (charger les modules, poser
#  les permissions) — il ne les crée pas, et on ne lui demande rien ici.
#
#  Il reste une garde, bornée et gratuite dans le cas courant : si le
#  répertoire est VIDE, on laisse une seconde au noyau. Sur du vrai matériel
#  il ne l'est jamais — il y a toujours au moins un pont hôte — donc cette
#  boucle sort au premier tour et ne coûte rien. Elle ne se paie que sur une
#  machine sans aucun PCI, où il n'y a de toute façon rien à décider.
attendre_le_bus() {
	I=0
	while [ "$I" -lt 10 ]; do
		for D in "$PCI"/*/; do
			[ -d "$D" ] && return 0
		done
		I=$((I + 1))
		sleep 0.1 2>/dev/null || return 0
	done
	return 0
}

carte_nvidia_presente() {
	for D in "$PCI"/*/; do
		[ -r "${D}vendor" ] && [ -r "${D}class" ] || continue
		[ "$(cat "${D}vendor" 2>/dev/null)" = "0x10de" ] || continue
		case "$(cat "${D}class" 2>/dev/null)" in
			0x0300*|0x0302*) return 0 ;;
		esac
	done
	return 1
}

# --- Les deux sens, et rien de destructif -----------------------------------
#  On renomme, on ne supprime jamais : un fichier mis de côté peut revenir.
#  CHANGE reste à 1 si quelque chose a bougé — l'initramfs devra suivre.
CHANGE=0

ranger() {                       # en place -> mis de côté
	for F in $REGLAGES; do
		if [ -f "$F" ]; then
			mv -f "$F" "${F}${SUFFIXE}" 2>/dev/null || continue
			dire "mis de côté : $(basename "$F")"
			CHANGE=1
		fi
	done
}

remettre() {                     # mis de côté -> en place
	for F in $REGLAGES; do
		if [ -f "${F}${SUFFIXE}" ] && [ ! -f "$F" ]; then
			mv -f "${F}${SUFFIXE}" "$F" 2>/dev/null || continue
			dire "remis en place : $(basename "$F")"
			CHANGE=1
		fi
	done
}

#  ═══ RIEN À GÉRER DU TOUT : ON NE LIT MÊME PAS LE BUS ═══
#  Seule l'ISO « pro » pose les deux fichiers de /etc/modprobe.d — c'est elle
#  qui embarque le pilote propriétaire. Sur « standard », « minimal », « dev »,
#  ils n'ont jamais existé, ni en place ni mis de côté. Ce service n'y a donc
#  strictement rien à décider, et il n'a aucune raison de parcourir le bus PCI
#  ni d'attendre qu'il se peuple.
#
#  C'est six appels à test(1), avant toute autre chose, et c'est la seule
#  sortie anticipée qui change quelque chose d'observable : sans elle, une
#  machine sans PCI lisible paierait l'attente d'une seconde pour rien, à
#  chaque démarrage, sur une ISO qui n'a même pas de réglages NVIDIA.
rien_a_gerer() {
	for F in $REGLAGES; do
		[ -f "$F" ] || [ -f "${F}${SUFFIXE}" ] && return 1
	done
	return 0
}

if rien_a_gerer; then
	exit 0
fi

attendre_le_bus

#  ═══ NE RIEN FAIRE QUAND IL N'Y A RIEN À FAIRE ═══
#  Au deuxième démarrage et à tous les suivants, il n'y a rien à déplacer : la
#  réponse ne change jamais sur une machine donnée. On répond donc d'abord à la
#  question la moins chère — « y a-t-il quoi que ce soit à bouger ? » — et on
#  sort si non.
#
#  HONNÊTETÉ SUR CE GARDE-FOU : AUCUN BANC NE PEUT LE TENIR, parce qu'il ne
#  change rien d'observable. Sans lui, « remettre » et « ranger » tournent, ne
#  trouvent rien, laissent CHANGE à 0 — et update-initramfs était DÉJÀ
#  conditionné à CHANGE=1 avant ce chantier. Sa suppression est une mutation
#  équivalente, vérifiée comme telle : le banc reste vert.
#  Il est gardé pour ce qu'il dit — l'intention est explicite au lieu d'être
#  déduite de deux boucles qui ne font rien — et non pour ce qu'il économise.
#  Ce qui économise vraiment est au-dessus (« rien_a_gerer », qui évite la
#  lecture du bus) et plus bas (l'initramfs différé).
NVIDIA=1
carte_nvidia_presente || NVIDIA=0

travail_a_faire() {
	for F in $REGLAGES; do
		if [ "$NVIDIA" = "1" ]; then
			[ -f "${F}${SUFFIXE}" ] && [ ! -f "$F" ] && return 0
		else
			[ -f "$F" ] && return 0
		fi
	done
	return 1
}

if ! travail_a_faire; then
	exit 0
fi

if [ "$NVIDIA" = "1" ]; then
	remettre
	[ "$CHANGE" = "1" ] && dire "carte NVIDIA détectée — réglages du pilote propriétaire actifs"
else
	ranger
	[ "$CHANGE" = "1" ] && dire "aucune carte NVIDIA — réglages du pilote rangés, nouveau reste disponible"
fi

# --- Répercuter sur l'initramfs, seulement si ça a bougé --------------------
#  Le blacklist agit dès l'initramfs : tant qu'il n'est pas régénéré, le
#  changement ne prendrait effet qu'à moitié. On ne le fait donc PAS à chaque
#  démarrage (ce serait une minute perdue à chaque fois) mais UNIQUEMENT le
#  jour où l'état change — c'est-à-dire une fois, au premier démarrage sur
#  une machine différente.
#
#  Jamais en session démo : le système de fichiers y est un empilement en
#  mémoire, régénérer l'initramfs n'y servirait à rien et prendrait du temps
#  au pire moment.
#
#  ═══ ET LES DEUX SENS NE SE VALENT PAS — C'EST LE POINT DÉLICAT ═══
#  update-initramfs prend une vingtaine de secondes, et ce service est ordonné
#  DEVANT l'écran de connexion. Les différer serait tentant dans les deux cas.
#  Ce serait faux dans l'un des deux :
#
#    · ON A REMIS LES RÉGLAGES (carte NVIDIA trouvée). L'interdiction de
#      « nouveau » doit valoir DÈS L'INITRAMFS : c'est de là que nouveau est
#      chargé, par KMS, avant même que la racine soit montée. Un initramfs
#      encore périmé au redémarrage suivant laisserait nouveau prendre une
#      RTX 50 dont il ne sait pas lire les sorties — l'écran noir qu'on a mis
#      des semaines à comprendre. Ces vingt secondes-là s'assument : elles
#      arrivent une fois, sur la machine où elles achètent quelque chose.
#
#    · ON A RANGÉ LES RÉGLAGES (aucune carte NVIDIA). Rien de ce démarrage-ci
#      n'en dépend : l'état voulu est justement que « nouveau » reste
#      disponible, et un initramfs périmé l'interdit encore — sans conséquence
#      sur une machine Intel, qui utilise i915. L'initramfs doit rattraper
#      avant le PROCHAIN démarrage, pas avant cet écran de connexion. On pose
#      donc un témoin, et lexos-gpu-initramfs.service fait le travail une fois
#      la session ouverte, à priorité basse.
#
#  C'est exactement le cas du ThinkPad : vingt secondes retirées de devant
#  l'écran de connexion, sans toucher d'un cheveu au chemin de l'Alienware.
if [ "$CHANGE" = "1" ] && ! grep -qa 'boot=live' "$CMDLINE" 2>/dev/null; then
	if [ "$NVIDIA" = "1" ]; then
		if command -v update-initramfs >/dev/null 2>&1; then
			update-initramfs -u >/dev/null 2>&1 \
				&& dire "initramfs mis à jour" \
				|| dire "!! update-initramfs a échoué — le changement sera complet au prochain noyau"
		fi
	else
		mkdir -p "${R}/run/lexos" 2>/dev/null || true
		if : > "${R}/run/lexos/gpu-initramfs-requis" 2>/dev/null; then
			dire "initramfs à rafraîchir — remis après l'ouverture de session"
		else
			#  Pas de témoin possible : on ne laisse pas le travail en plan.
			#  Un initramfs jamais rafraîchi finirait par diverger pour de bon.
			if command -v update-initramfs >/dev/null 2>&1; then
				update-initramfs -u >/dev/null 2>&1 \
					&& dire "initramfs mis à jour (témoin impossible, fait tout de suite)" \
					|| dire "!! update-initramfs a échoué — le changement sera complet au prochain noyau"
			fi
		fi
	fi
fi

exit 0
