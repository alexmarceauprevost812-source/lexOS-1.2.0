# =============================================================================
#  LexOS — fichiers produits par la construction
# =============================================================================

# --- Sorties de live-build ---------------------------------------------------
*.iso
*.iso.sha256
*.img
*.contents
*.files
*.packages
build.log
binary/
chroot/
chroot.files
cache/
local/
.build/

# --- Fichiers que `lb config` génère à la racine de config/ -----------------
config/binary
config/bootstrap
config/chroot
config/common
config/source
config/source-*

# --- Fichiers générés par build.sh ------------------------------------------
config/package-lists/zz-flavour-*.list.chroot
config/includes.chroot/etc/lexos/build.conf
config/includes.chroot/usr/share/lexos/branding/

# --- Aperçus locaux ----------------------------------------------------------
preview/

# --- Divers ------------------------------------------------------------------
*.swp
*~
.DS_Store

# --- Caches Python -----------------------------------------------------------
__pycache__/
*.pyc

# --- Outils téléchargés, jamais versionnés ----------------------------------
#  Un .whl de shellcheck (3,7 Mio) avait fini committé à la racine : c'est un
#  binaire d'outillage, pas une source du projet. La cible « lint » du
#  Makefile cherche shellcheck dans le PATH et dit quoi installer s'il
#  manque — le dépôt n'a pas à porter le binaire.
*.whl

#  ═══ LE vendor/ DU TERMINAL EST POSÉ À LA CONSTRUCTION, PAS ICI ═══
#  usr/share/lexos/terminal-pro/web/vendor/ contient des LIENS vers xterm.js
#  et sa feuille de style, dans /usr/share/nodejs — le hook 0455 les crée à
#  partir du paquet Debian « node-xterm ». Les versionner mettrait dans le
#  dépôt des liens qui ne pointent nulle part sur une autre machine, et
#  ferait croire que la page marche là où le paquet n'est pas installé.
#  Le banc du navigateur les pose puis les retire ; cette ligne garantit
#  qu'un banc interrompu ne laisse rien derrière lui dans un commit.
config/includes.chroot/usr/share/lexos/terminal-pro/web/vendor/
